:"/docs/infrastructure/Guides/add-a-new-secret","type":"heading","tags":[],"url":"/docs/infrastructure/Guides/add-a-new-secret#introduction","content":"Introduction"},"186":{"id":"/docs/infrastructure/Guides/add-a-new-secret-1","page_id":"/docs/infrastructure/Guides/add-a-new-secret","type":"heading","tags":[],"url":"/docs/infrastructure/Guides/add-a-new-secret#basics","content":"Basics"},"187":{"id":"/docs/infrastructure/Guides/add-a-new-secret-2","page_id":"/docs/infrastructure/Guides/add-a-new-secret","type":"heading","tags":[],"url":"/docs/infrastructure/Guides/add-a-new-secret#add-the-secret-into-the-key-vault","content":"Add the secret into the Key Vault"},"188":{"id":"/docs/infrastructure/Guides/add-a-new-secret-3","page_id":"/docs/infrastructure/Guides/add-a-new-secret","type":"heading","tags":[],"url":"/docs/infrastructure/Guides/add-a-new-secret#declare-the-externalsecret","content":"Declare the `ExternalSecret`"},"189":{"id":"/docs/infrastructure/Guides/add-a-new-secret-4","page_id":"/docs/infrastructure/Guides/add-a-new-secret","type":"heading","tags":[],"url":"/docs/infrastructure/Guides/add-a-new-secret#allow-the-namespace-to-use-the-store","content":"Allow the namespace to use the store"},"190":{"id":"/docs/infrastructure/Guides/add-a-new-secret-5","page_id":"/docs/infrastructure/Guides/add-a-new-secret","type":"heading","tags":[],"url":"/docs/infrastructure/Guides/add-a-new-secret#add-a-key-to-an-existing-externalsecret","content":"Add a key to an existing `ExternalSecret`"},"191":{"id":"/docs/infrastructure/Guides/add-a-new-secret-6","page_id":"/docs/infrastructure/Guides/add-a-new-secret","type":"heading","tags":[],"url":"/docs/infrastructure/Guides/add-a-new-secret#use-the-secret-in-a-pod","content":"Use the secret in a pod"},"192":{"id":"/docs/infrastructure/Guides/add-a-new-secret-7","page_id":"/docs/infrastructure/Guides/add-a-new-secret","type":"heading","tags":[],"url":"/docs/infrastructure/Guides/add-a-new-secret#as-an-environment-variable","content":"As an environment variable"},"193":{"id":"/docs/infrastructure/Guides/add-a-new-secret-8","page_id":"/docs/infrastructure/Guides/add-a-new-secret","type":"heading","tags":[],"url":"/docs/infrastructure/Guides/add-a-new-secret#as-a-file-deprecated","content":"As a file (deprecated)"},"194":{"id":"/docs/infrastructure/Guides/add-a-new-secret-9","page_id":"/docs/infrastructure/Guides/add-a-new-secret","type":"heading","tags":[],"url":"/docs/infrastructure/Guides/add-a-new-secret#deploy-and-check","content":"Deploy and check"},"195":{"id":"/docs/infrastructure/Guides/add-a-new-secret-10","page_id":"/docs/infrastructure/Guides/add-a-new-secret","type":"heading","tags":[],"url":"/docs/infrastructure/Guides/add-a-new-secret#updating-a-secret-value","content":"Updating a secret value"},"196":{"id":"/docs/infrastructure/Guides/add-a-new-secret-11","page_id":"/docs/infrastructure/Guides/add-a-new-secret","type":"heading","tags":[],"url":"/docs/infrastructure/Guides/add-a-new-secret#key-vault-management","content":"Key Vault management"},"197":{"id":"/docs/infrastructure/Guides/add-a-new-secret-12","page_id":"/docs/infrastructure/Guides/add-a-new-secret","type":"heading","tags":[],"url":"/docs/infrastructure/Guides/add-a-new-secret#add-or-update-a-secret","content":"Add or update a secret"},"198":{"id":"/docs/infrastructure/Guides/add-a-new-secret-13","page_id":"/docs/infrastructure/Guides/add-a-new-secret","type":"heading","tags":[],"url":"/docs/infrastructure/Guides/add-a-new-secret#delete-a-secret","content":"Delete a secret"},"199":{"id":"/docs/infrastructure/Guides/add-a-new-secret-14","page_id":"/docs/infrastructure/Guides/add-a-new-secret","type":"heading","tags":[],"url":"/docs/infrastructure/Guides/add-a-new-secret#example","content":"Example"},"200":{"id":"/docs/infrastructure/Guides/add-a-new-secret-15","page_id":"/docs/infrastructure/Guides/add-a-new-secret","tags":[],"type":"text","url":"/docs/infrastructure/Guides/add-a-new-secret#introduction","content":"Secrets are used to configure deployments with **sensitive** data like database login, API keys, and so on.  \nSecrets live in **Azure Key Vault** and never in Git. The\nExternal Secrets Operator (ESO), running in the\ncluster, copies them into regular Kubernetes `Secret`s that your pods can use."},"201":{"id":"/docs/infrastructure/Guides/add-a-new-secret-16","page_id":"/docs/infrastructure/Guides/add-a-new-secret","tags":[],"type":"text","url":"/docs/infrastructure/Guides/add-a-new-secret#introduction","content":"We have two Key Vaults, one per trust boundary:"},"202":{"id":"/docs/infrastructure/Guides/add-a-new-secret-17","page_id":"/docs/infrastructure/Guides/add-a-new-secret","tags":[],"type":"text","url":"/docs/infrastructure/Guides/add-a-new-secret#introduction","content":"| Key Vault    | `ClusterSecretStore` | Contains                                                         | Namespaces allowed to read it          |\n| ------------ | -------------------- | ---------------------------------------------------------------- | -------------------------------------- |\n| `kv-pn-apps` | `kv-pn-apps`         | Application secrets (DB passwords, API keys, OAuth clients, ...) | The app namespaces listed in the store |","table":"table-0"},"203":{"id":"/docs/infrastructure/Guides/add-a-new-secret-18","page_id":"/docs/infrastructure/Guides/add-a-new-secret","tags":[],"type":"text","url":"/docs/infrastructure/Guides/add-a-new-secret#introduction","content":"| Key Vault     | `ClusterSecretStore` | Contains                                                             | Namespaces allowed to read it |\n| ------------- | -------------------- | -------------------------------------------------------------------- | ----------------------------- |\n| `kv-pn-infra` | `kv-pn-infra`        | Platform secrets (tunnel token, Flux webhook token, backup key, ...) | `cloudflared`, `flux-system`  |","table":"table-0"},"204":{"id":"/docs/infrastructure/Guides/add-a-new-secret-19","page_id":"/docs/infrastructure/Guides/add-a-new-secret","tags":[],"type":"text","url":"/docs/infrastructure/Guides/add-a-new-secret#introduction","content":"ESO reads Key Vault through workload identity federation: no Azure password or\nkey is stored in the cluster."},"205":{"id":"/docs/infrastructure/Guides/add-a-new-secret-20","page_id":"/docs/infrastructure/Guides/add-a-new-secret","tags":[],"type":"text","url":"/docs/infrastructure/Guides/add-a-new-secret#introduction","content":"Whenever there is `<something>` in the code or in a command, that's a parameter you need to set."},"206":{"id":"/docs/infrastructure/Guides/add-a-new-secret-21","page_id":"/docs/infrastructure/Guides/add-a-new-secret","tags":[],"type":"text","url":"/docs/infrastructure/Guides/add-a-new-secret#basics","content":"There are three required steps:"},"207":{"id":"/docs/infrastructure/Guides/add-a-new-secret-22","page_id":"/docs/infrastructure/Guides/add-a-new-secret","tags":[],"type":"text","url":"/docs/infrastructure/Guides/add-a-new-secret#basics","content":"Add the secret into the Key Vault"},"208":{"id":"/docs/infrastructure/Guides/add-a-new-secret-23","page_id":"/docs/infrastructure/Guides/add-a-new-secret","tags":[],"type":"text","url":"/docs/infrastructure/Guides/add-a-new-secret#basics","content":"Declare an `ExternalSecret` in the app folder"},"209":{"id":"/docs/infrastructure/Guides/add-a-new-secret-24","page_id":"/docs/infrastructure/Guides/add-a-new-secret","tags":[],"type":"text","url":"/docs/infrastructure/Guides/add-a-new-secret#basics","content":"Use the Kubernetes secret in the pod"},"210":{"id":"/docs/infrastructure/Guides/add-a-new-secret-25","page_id":"/docs/infrastructure/Guides/add-a-new-secret","tags":[],"type":"text","url":"/docs/infrastructure/Guides/add-a-new-secret#basics","content":"All the YAML lives in the app folder `apps/<namespace>/` of\npolinetwork-cd."},"211":{"id":"/docs/infrastructure/Guides/add-a-new-secret-26","page_id":"/docs/infrastructure/Guides/add-a-new-secret","tags":[],"type":"text","url":"/docs/infrastructure/Guides/add-a-new-secret#add-the-secret-into-the-key-vault","content":"See this section."},"212":{"id":"/docs/infrastructure/Guides/add-a-new-secret-27","page_id":"/docs/infrastructure/Guides/add-a-new-secret","tags":[],"type":"text","url":"/docs/infrastructure/Guides/add-a-new-secret#add-the-secret-into-the-key-vault","content":"Prefix the Key Vault secret name with the app that owns it, e.g. `backend-encryption-key`.\nKey Vault names allow only letters, digits and hyphens."},"213":{"id":"/docs/infrastructure/Guides/add-a-new-secret-28","page_id":"/docs/infrastructure/Guides/add-a-new-secret","tags":[],"type":"text","url":"/docs/infrastructure/Guides/add-a-new-secret#declare-the-externalsecret","content":"Check if the app folder already contains an `external-secret.yaml`. If it does,\njust add a new entry."},"214":{"id":"/docs/infrastructure/Guides/add-a-new-secret-29","page_id":"/docs/infrastructure/Guides/add-a-new-secret","tags":[],"type":"text","url":"/docs/infrastructure/Guides/add-a-new-secret#declare-the-externalsecret","content":"Otherwise create it:"},"215":{"id":"/docs/infrastructure/Guides/add-a-new-secret-30","page_id":"/docs/infrastructure/Guides/add-a-new-secret","tags":[],"type":"text","url":"/docs/infrastructure/Guides/add-a-new-secret#declare-the-externalsecret","content":"and add it to the app's `kustomization.yaml`:"},"216":{"id":"/docs/infrastructure/Guides/add-a-new-secret-31","page_id":"/docs/infrastructure/Guides/add-a-new-secret","tags":[],"type":"text","url":"/docs/infrastructure/Guides/add-a-new-secret#declare-the-externalsecret","content":"There is no need to set the namespace in the `ExternalSecret`: Kustomize sets it\nfrom the `namespace` field of `kustomization.yaml`."},"217":{"id":"/docs/infrastructure/Guides/add-a-new-secret-32","page_id":"/docs/infrastructure/Guides/add-a-new-secret","tags":[],"type":"text","url":"/docs/infrastructure/Guides/add-a-new-secret#declare-the-externalsecret","content":"By convention, our apps call both the `ExternalSecret` and the resulting Secret\n`azure-kv`, a name inherited from the AKS setup."},"218":{"id":"/docs/infrastructure/Guides/add-a-new-secret-33","page_id":"/docs/infrastructure/Guides/add-a-new-secret","tags":[],"type":"text","url":"/docs/infrastructure/Guides/add-a-new-secret#allow-the-namespace-to-use-the-store","content":"A `ClusterSecretStore` only serves the namespaces listed in its `conditions`.\nIf your app is new, add its namespace to the `kv-pn-apps` store:"},"219":{"id":"/docs/infrastructure/Guides/add-a-new-secret-34","page_id":"/docs/infrastructure/Guides/add-a-new-secret","tags":[],"type":"text","url":"/docs/infrastructure/Guides/add-a-new-secret#allow-the-namespace-to-use-the-store","content":"Skip this and the `ExternalSecret` stays `NotReady` with an error saying the\nstore doesn't allow the namespace."},"220":{"id":"/docs/infrastructure/Guides/add-a-new-secret-35","page_id":"/docs/infrastructure/Guides/add-a-new-secret","tags":[],"type":"text","url":"/docs/infrastructure/Guides/add-a-new-secret#allow-the-namespace-to-use-the-store","content":"Don't add app namespaces to `kv-pn-infra`. It holds the secrets that run the\nplatform itself."},"221":{"id":"/docs/infrastructure/Guides/add-a-new-secret-36","page_id":"/docs/infrastructure/Guides/add-a-new-secret","tags":[],"type":"text","url":"/docs/infrastructure/Guides/add-a-new-secret#add-a-key-to-an-existing-externalsecret","content":"Append an entry under `data`:"},"222":{"id":"/docs/infrastructure/Guides/add-a-new-secret-37","page_id":"/docs/infrastructure/Guides/add-a-new-secret","tags":[],"type":"text","url":"/docs/infrastructure/Guides/add-a-new-secret#as-a-file-deprecated","content":"Use environment variables instead. Mounting the\nSecret as a volume was required by the old CSI driver; with ESO it's only extra\nYAML, and no app does it anymore. Keep it for an app that can only read its\nconfiguration from files."},"223":{"id":"/docs/infrastructure/Guides/add-a-new-secret-38","page_id":"/docs/infrastructure/Guides/add-a-new-secret","tags":[],"type":"text","url":"/docs/infrastructure/Guides/add-a-new-secret#deploy-and-check","content":"Open a PR into polinetwork-cd. Once it's merged, Flux applies it. Then, from the node:"},"224":{"id":"/docs/infrastructure/Guides/add-a-new-secret-39","page_id":"/docs/infrastructure/Guides/add-a-new-secret","tags":[],"type":"text","url":"/docs/infrastructure/Guides/add-a-new-secret#updating-a-secret-value","content":"ESO re-reads Key Vault every `refreshInterval` (1 hour). To pick up a new value\nimmediately, force a sync:"},"225":{"id":"/docs/infrastructure/Guides/add-a-new-secret-40","page_id":"/docs/infrastructure/Guides/add-a-new-secret","tags":[],"type":"text","url":"/docs/infrastructure/Guides/add-a-new-secret#updating-a-secret-value","content":"Environment variables are read only when a container starts, so restart the app:"},"226":{"id":"/docs/infrastructure/Guides/add-a-new-secret-41","page_id":"/docs/infrastructure/Guides/add-a-new-secret","tags":[],"type":"text","url":"/docs/infrastructure/Guides/add-a-new-secret#updating-a-secret-value","content":"(Secrets mounted as files are updated in place after a short delay, but the app\nhas to re-read them.)"},"227":{"id":"/docs/infrastructure/Guides/add-a-new-secret-42","page_id":"/docs/infrastructure/Guides/add-a-new-secret","tags":[],"type":"text","url":"/docs/infrastructure/Guides/add-a-new-secret#key-vault-management","content":"You need the Azure CLI, logged in with an account that has the\n**Key Vault Secrets Officer** role on the vault."},"228":{"id":"/docs/infrastructure/Guides/add-a-new-secret-43","page_id":"/docs/infrastructure/Guides/add-a-new-secret","tags":[],"type":"text","url":"/docs/infrastructure/Guides/add-a-new-secret#add-or-update-a-secret","content":"You can add (or update) a secret with the following command:"},"229":{"id":"/docs/infrastructure/Guides/add-a-new-secret-44","page_id":"/docs/infrastructure/Guides/add-a-new-secret","tags":[],"type":"text","url":"/docs/infrastructure/Guides/add-a-new-secret#add-or-update-a-secret","content":"If the secret value is too long or you don't want to copy/paste in terminal (and\nleave it in your shell history) you can use a file instead."},"230":{"id":"/docs/infrastructure/Guides/add-a-new-secret-45","page_id":"/docs/infrastructure/Guides/add-a-new-secret","tags":[],"type":"text","url":"/docs/infrastructure/Guides/add-a-new-secret#add-or-update-a-secret","content":"Paste the secret value into a text file (no extension or \".txt\" is valid) on a **single line**"},"231":{"id":"/docs/infrastructure/Guides/add-a-new-secret-46","page_id":"/docs/infrastructure/Guides/add-a-new-secret","tags":[],"type":"text","url":"/docs/infrastructure/Guides/add-a-new-secret#add-or-update-a-secret","content":"Run the following command"},"232":{"id":"/docs/infrastructure/Guides/add-a-new-secret-47","page_id":"/docs/infrastructure/Guides/add-a-new-secret","tags":[],"type":"text","url":"/docs/infrastructure/Guides/add-a-new-secret#add-or-update-a-secret","content":"Delete the file"},"233":{"id":"/docs/infrastructure/Guides/add-a-new-secret-48","page_id":"/docs/infrastructure/Guides/add-a-new-secret","tags":[],"type":"text","url":"/docs/infrastructure/Guides/add-a-new-secret#delete-a-secret","content":"Remove it from every `ExternalSecret` first, otherwise the `ExternalSecret` turns\n`NotReady`. Then delete it with:"},"234":{"id":"/docs/infrastructure/Guides/add-a-new-secret-49","page_id":"/docs/infrastructure/Guides/add-a-new-secret","tags":[],"type":"text","url":"/docs/infrastructure/Guides/add-a-new-secret#delete-a-secret","content":"After the deletion, the secret remains in a `Recoverable State` for **90 days**.  \nDuring this period the secret can be recovered with the following command:"},"235":{"id":"/docs/infrastructure/Guides/add-a-new-secret-50","page_id":"/docs/infrastructure/Guides/add-a-new-secret","tags":[],"type":"text","url":"/docs/infrastructure/Guides/add-a-new-secret#delete-a-secret","content":"Both vaults have **purge protection** enabled: a deleted secret can't be purged\nbefore its 90 days are over, and its name can't be reused in the meantime unless\nyou recover it."},"236":{"id":"/docs/infrastructure/Guides/add-a-new-secret-51","page_id":"/docs/infrastructure/Guides/add-a-new-secret","tags":[],"type":"text","url":"/docs/infrastructure/Guides/add-a-new-secret#delete-a-secret","content":"To **update/re-set** that secret, during the 90 days retention period, you must recover it first,\nthen run the command to update it"},"237":{"id":"/docs/infrastructure/Guides/add-a-new-secret-52","page_id":"/docs/infrastructure/Guides/add-a-new-secret","tags":[],"type":"text","url":"/docs/infrastructure/Guides/add-a-new-secret#delete-a-secret","content":"If you try to `set` a secret that has been deleted within the last 90 days without restoring it first, you get the following error:"},"238":{"id":"/docs/infrastructure/Guides/add-a-new-secret-53","page_id":"/docs/infrastructure/Guides/add-a-new-secret","tags":[],"type":"text","url":"/docs/infrastructure/Guides/add-a-new-secret#example","content":"A complete app that reads one secret, `my-app-api-key`, from `kv-pn-apps`:"},"239":{"id":"/docs/infrastructure/Guides/add-a-new-secret-54","page_id":"/docs/infrastructure/Guides/add-a-new-secret","tags":[],"type":"text","url":"/docs/infrastructure/Guides/add-a-new-secret#example","content":"Plus `my-app` in the `kv-pn-apps` store conditions, as shown above."},"240":{"id":"/docs/infrastructure/Guides/add-storage","page_id":"/docs/infrastructure/Guides/add-storage","type":"page","content":"Add Storage","breadcrumbs":["Docs","Infrastructure","Guides"],"tags":[],"url":"/docs/infrastructure/Guides/add-storage"},"241":{"id":"/docs/infrastructure/Guides/add-storage-0","page_id":"/docs/infrastructure/Guides/add-storage","type":"heading","tags":[],"url":"/docs/infrastructure/Guides/add-storage#core-concepts","content":"Core Concepts"},"242":{"id":"/docs/infrastructure/Guides/add-storage-1","page_id":"/docs/infrastructure/Guides/add-storage","type":"heading","tags":[],"url":"/docs/infrastructure/Guides/add-storage#add-a-volume","content":"Add a volume"},"243":{"id":"/docs/infrastructure/Guides/add-storage-2","page_id":"/docs/infrastructure/Guides/add-storage","type":"heading","tags":[],"url":"/docs/infrastructure/Guides/add-storage#back-it-up","content":"Back it up"},"244":{"id":"/docs/infrastructure/Guides/add-storage-3","page_id":"/docs/infrastructure/Guides/add-storage","type":"heading","tags":[],"url":"/docs/infrastructure/Guides/add-storage#inspecting-a-volume","content":"Inspecting a volume"},"245":{"id":"/docs/infrastructure/Guides/add-storage-4","page_id":"/docs/infrastructure/Guides/add-storage","tags":[],"type":"text","url":"/docs/infrastructure/Guides/add-storage#core-concepts","content":"Many applications and services need a physical volume or storage to store their data or configuration.  \nOn K3s, volumes are plain directories on the node's data disks, created on demand by the\nlocal-path provisioner when a\nPVC asks for one.\nWe replaced Longhorn and the Azure Managed Disk volumes we used on AKS with it."},"246":{"id":"/docs/infrastructure/Guides/add-storage-5","page_id":"/docs/infrastructure/Guides/add-storage","tags":[],"type":"text","url":"/docs/infrastructure/Guides/add-storage#core-concepts","content":"There are two storage classes, one per data disk:"},"247":{"id":"/docs/infrastructure/Guides/add-storage-6","page_id":"/docs/infrastructure/Guides/add-storage","tags":[],"type":"text","url":"/docs/infrastructure/Guides/add-storage#core-concepts","content":"| Storage class | Disk                  | Path on the node                       | Use it for                                                              |\n| ------------- | --------------------- | -------------------------------------- | ----------------------------------------------------------------------- |\n| `fast`        | Premium SSD v2, 64 GB | `/srv/fast/volumes/<namespace>/<pvc>/` | Latency-sensitive databases (today: PostgreSQL and the Redis instances) |","table":"table-0"},"248":{"id":"/docs/infrastructure/Guides/add-storage-7","page_id":"/docs/infrastructure/Guides/add-storage","tags":[],"type":"text","url":"/docs/infrastructure/Guides/add-storage#core-concepts","content":"| Storage class        | Disk                 | Path on the node                           | Use it for                                                          |\n| -------------------- | -------------------- | ------------------------------------------ | ------------------------------------------------------------------- |\n| `standard` (default) | Standard SSD, 128 GB | `/srv/standard/volumes/<namespace>/<pvc>/` | Everything else (today: InfluxDB, Prometheus, Grafana, Uptime Kuma) |","table":"table-0"},"249":{"id":"/docs/infrastructure/Guides/add-storage-8","page_id":"/docs/infrastructure/Guides/add-storage","tags":[],"type":"text","url":"/docs/infrastructure/Guides/add-storage#core-concepts","content":"**The size is not enforced.** `storage: 4Gi` in a PVC is a label, not a quota: a volume can\ngrow until the whole disk is full, and then every app on that disk breaks.\nCheck the free space first, and keep an eye on the `PersistentVolumeHigh` and\n`NodeDiskHigh` alerts."},"250":{"id":"/docs/infrastructure/Guides/add-storage-9","page_id":"/docs/infrastructure/Guides/add-storage","tags":[],"type":"text","url":"/docs/infrastructure/Guides/add-storage#core-concepts","content":"**`ReadWriteOnce` doesn't mean one pod.** It limits a volume to one node, and we only\nhave one node: two pods can mount the same volume and write to it at the same time.\nMake sure only one pod at a time uses it (see `Recreate` below)."},"251":{"id":"/docs/infrastructure/Guides/add-storage-10","page_id":"/docs/infrastructure/Guides/add-storage","tags":[],"type":"text","url":"/docs/infrastructure/Guides/add-storage#core-concepts","content":"**Volumes are retained.** Deleting a PVC doesn't delete its directory (`reclaimPolicy: Retain`)."},"252":{"id":"/docs/infrastructure/Guides/add-storage-11","page_id":"/docs/infrastructure/Guides/add-storage","tags":[],"type":"text","url":"/docs/infrastructure/Guides/add-storage#add-a-volume","content":"First of all, SSH into the node and check\nhow much space is available on the disk you want to use:"},"253":{"id":"/docs/infrastructure/Guides/add-storage-12","page_id":"/docs/infrastructure/Guides/add-storage","tags":[],"type":"text","url":"/docs/infrastructure/Guides/add-storage#add-a-volume","content":"Once you verified you have sufficient space available, add the PVC to the app manifest:"},"254":{"id":"/docs/infrastructure/Guides/add-storage-13","page_id":"/docs/infrastructure/Guides/add-storage","tags":[],"type":"text","url":"/docs/infrastructure/Guides/add-storage#add-a-volume","content":"Parameters:"},"255":{"id":"/docs/infrastructure/Guides/add-storage-14","page_id":"/docs/infrastructure/Guides/add-storage","tags":[],"type":"text","url":"/docs/infrastructure/Guides/add-storage#add-a-volume","content":"`namespace` k8s namespace (set by the app's `kustomization.yaml`)"},"256":{"id":"/docs/infrastructure/Guides/add-storage-15","page_id":"/docs/infrastructure/Guides/add-storage","tags":[],"type":"text","url":"/docs/infrastructure/Guides/add-storage#add-a-volume","content":"`name` should identify the app where the volume will be used"},"257":{"id":"/docs/infrastructure/Guides/add-storage-16","page_id":"/docs/infrastructure/Guides/add-storage","tags":[],"type":"text","url":"/docs/infrastructure/Guides/add-storage#add-a-volume","content":"`storage-class` `fast` or `standard` (see the table above)"},"258":{"id":"/docs/infrastructure/Guides/add-storage-17","page_id":"/docs/infrastructure/Guides/add-storage","tags":[],"type":"text","url":"/docs/infrastructure/Guides/add-storage#add-a-volume","content":"`size` expected size of the volume. Check resource units.\n  e.g. `300M`, `1Gi`, `200Mi`"},"259":{"id":"/docs/infrastructure/Guides/add-storage-18","page_id":"/docs/infrastructure/Guides/add-storage","tags":[],"type":"text","url":"/docs/infrastructure/Guides/add-storage#add-a-volume","content":"The `kustomize.toolkit.fluxcd.io/prune: disabled` annotation keeps Flux from deleting the\nPVC if it disappears from Git (e.g. a bad refactor). CI rejects PVCs without it."},"260":{"id":"/docs/infrastructure/Guides/add-storage-19","page_id":"/docs/infrastructure/Guides/add-storage","tags":[],"type":"text","url":"/docs/infrastructure/Guides/add-storage#add-a-volume","content":"The `Recreate` strategy avoids two pods writing to the same volume during a rollout."},"261":{"id":"/docs/infrastructure/Guides/add-storage-20","page_id":"/docs/infrastructure/Guides/add-storage","tags":[],"type":"text","url":"/docs/infrastructure/Guides/add-storage#add-a-volume","content":"The volume is created when the first pod using it is scheduled, so the PVC stays\n`Pending` until then: that's expected."},"262":{"id":"/docs/infrastructure/Guides/add-storage-21","page_id":"/docs/infrastructure/Guides/add-storage","tags":[],"type":"text","url":"/docs/infrastructure/Guides/add-storage#add-a-volume","content":"local-path directories are owned by `root`. If your container runs as a non-root\nuser, set `securityContext.fsGroup` on the pod to the user's group (see `apps/redis`\nfor an example)."},"263":{"id":"/docs/infrastructure/Guides/add-storage-22","page_id":"/docs/infrastructure/Guides/add-storage","tags":[],"type":"text","url":"/docs/infrastructure/Guides/add-storage#back-it-up","content":"Volumes are **not** backed up automatically. The application backup on the node\nonly includes the databases and directories it knows about. If the new volume\nholds data we can't afford to lose, add it to the backup script: see\nBackups."},"264":{"id":"/docs/infrastructure/Guides/add-storage-23","page_id":"/docs/infrastructure/Guides/add-storage","tags":[],"type":"text","url":"/docs/infrastructure/Guides/add-storage#inspecting-a-volume","content":"Since a volume is just a directory, you can look at it from the node:"},"265":{"id":"/docs/infrastructure/Guides/add-storage-24","page_id":"/docs/infrastructure/Guides/add-storage","tags":[],"type":"text","url":"/docs/infrastructure/Guides/add-storage#inspecting-a-volume","content":"Don't edit files of a running database from the node. Stop the app first, or go\nthrough the app itself."},"266":{"id":"/docs/infrastructure/Guides/backups","page_id":"/docs/infrastructure/Guides/backups","type":"page","content":"Backups","breadcrumbs":["Docs","Infrastructure","Guides"],"tags":[],"url":"/docs/infrastructure/Guides/backups"},"267":{"id":"/docs/infrastructure/Guides/backups-0","page_id":"/docs/infrastructure/Guides/backups","type":"heading","tags":[],"url":"/docs/infrastructure/Guides/backups#overview","content":"Overview"},"268":{"id":"/docs/infrastructure/Guides/backups-1","page_id":"/docs/infrastructure/Guides/backups","type":"heading","tags":[],"url":"/docs/infrastructure/Guides/backups#retention","content":"Retention"},"269":{"id":"/docs/infrastructure/Guides/backups-2","page_id":"/docs/infrastructure/Guides/backups","type":"heading","tags":[],"url":"/docs/infrastructure/Guides/backups#monitoring","content":"Monitoring"},"270":{"id":"/docs/infrastructure/Guides/backups-3","page_id":"/docs/infrastructure/Guides/backups","type":"heading","tags":[],"url":"/docs/infrastructure/Guides/backups#adding-a-new-app","content":"Adding a new app"},"271":{"id":"/docs/infrastructure/Guides/backups-4","page_id":"/docs/infrastructure/Guides/backups","type":"heading","tags":[],"url":"/docs/infrastructure/Guides/backups#restoring","content":"Restoring"},"272":{"id":"/docs/infrastructure/Guides/backups-5","page_id":"/docs/infrastructure/Guides/backups","type":"heading","tags":[],"url":"/docs/infrastructure/Guides/backups#1-get-the-archive","content":"1. Get the archive"},"273":{"id":"/docs/infrastructure/Guides/backups-6","page_id":"/docs/infrastructure/Guides/backups","type":"heading","tags":[],"url":"/docs/infrastructure/Guides/backups#2-decrypt-it-on-your-machine","content":"2. Decrypt it on your machine"},"274":{"id":"/docs/infrastructure/Guides/backups-7","page_id":"/docs/infrastructure/Guides/backups","type":"heading","tags":[],"url":"/docs/infrastructure/Guides/backups#3-restore-the-data","content":"3. Restore the data"},"275":{"id":"/docs/infrastructure/Guides/backups-8","page_id":"/docs/infrastructure/Guides/backups","tags":[],"type":"text","url":"/docs/infrastructure/Guides/backups#overview","content":"Two systemd timers on the node, installed by Ansible (`ansible/roles/backup`), back up the cluster:"},"276":{"id":"/docs/infrastructure/Guides/backups-9","page_id":"/docs/infrastructure/Guides/backups","tags":[],"type":"text","url":"/docs/infrastructure/Guides/backups#overview","content":"| Backup                                      | When (UTC)                                 | Contents                                                                                                                                                                         |\n| ------------------------------------------- | ------------------------------------------ | -------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| **Applications** (`k3s-application-backup`) | Every 6 hours (00:45, 06:45, 12:45, 18:45) | PostgreSQL (`pg_dumpall`, all databases and roles), Redis (`redis` and `bot-ts` RDB snapshots), InfluxDB (`influx backup`), Uptime Kuma and Grafana (SQLite databases and files) |","table":"table-0"},"277":{"id":"/docs/infrastructure/Guides/backups-10","page_id":"/docs/infrastructure/Guides/backups","tags":[],"type":"text","url":"/docs/infrastructure/Guides/backups#overview","content":"| Backup                                         | When (UTC)     | Contents                                                               |\n| ---------------------------------------------- | -------------- | ---------------------------------------------------------------------- |\n| **Control plane** (`k3s-control-plane-backup`) | Daily at 02:15 | The K3s datastore (`state.db`), the K3s server token and `config.yaml` |","table":"table-0"},"278":{"id":"/docs/infrastructure/Guides/backups-11","page_id":"/docs/infrastructure/Guides/backups","tags":[],"type":"text","url":"/docs/infrastructure/Guides/backups#overview","content":"Each run:"},"279":{"id":"/docs/infrastructure/Guides/backups-12","page_id":"/docs/infrastructure/Guides/backups","tags":[],"type":"text","url":"/docs/infrastructure/Guides/backups#overview","content":"takes consistent online copies (no app is stopped);"},"280":{"id":"/docs/infrastructure/Guides/backups-13","page_id":"/docs/infrastructure/Guides/backups","tags":[],"type":"text","url":"/docs/infrastructure/Guides/backups#overview","content":"packs them in a `.tar.gz` with a `SHA256SUMS` file and encrypts it with\nage;"},"281":{"id":"/docs/infrastructure/Guides/backups-14","page_id":"/docs/infrastructure/Guides/backups","tags":[],"type":"text","url":"/docs/infrastructure/Guides/backups#overview","content":"uploads it to the private `backups` container of the `polinetworkbackups`\nstorage account, using the `id-k3s-backup` managed identity;"},"282":{"id":"/docs/infrastructure/Guides/backups-15","page_id":"/docs/infrastructure/Guides/backups","tags":[],"type":"text","url":"/docs/infrastructure/Guides/backups#overview","content":"publishes its success time to Prometheus."},"283":{"id":"/docs/infrastructure/Guides/backups-16","page_id":"/docs/infrastructure/Guides/backups","tags":[],"type":"text","url":"/docs/infrastructure/Guides/backups#overview","content":"The node only has the age **public** key. The private key (the \"identity\") is the\nsecret `backup-age-identity` in the `kv-pn-infra` Key Vault, and it must never be\ncopied to the node. Without it, the backups can't be read."},"284":{"id":"/docs/infrastructure/Guides/backups-17","page_id":"/docs/infrastructure/Guides/backups","tags":[],"type":"text","url":"/docs/infrastructure/Guides/backups#retention","content":"| Where | Path                                                                                  | Kept for |\n| ----- | ------------------------------------------------------------------------------------- | -------- |\n| Node  | `/srv/standard/backups/k3s-applications/`, `/srv/standard/backups/k3s-control-plane/` | 7 days   |","table":"table-1"},"285":{"id":"/docs/infrastructure/Guides/backups-18","page_id":"/docs/infrastructure/Guides/backups","tags":[],"type":"text","url":"/docs/infrastructure/Guides/backups#retention","content":"| Where        | Path                                                                  | Kept for                            |\n| ------------ | --------------------------------------------------------------------- | ----------------------------------- |\n| Blob Storage | `backups/k3s-applications/k3s01/`, `backups/k3s-control-plane/k3s01/` | 90 days, immutable for the first 30 |","table":"table-1"},"286":{"id":"/docs/infrastructure/Guides/backups-19","page_id":"/docs/infrastructure/Guides/backups","tags":[],"type":"text","url":"/docs/infrastructure/Guides/backups#retention","content":"The storage account only accepts traffic from the K3s subnet, so download backups from the node."},"287":{"id":"/docs/infrastructure/Guides/backups-20","page_id":"/docs/infrastructure/Guides/backups","tags":[],"type":"text","url":"/docs/infrastructure/Guides/backups#monitoring","content":"The `BackupStale` alert fires on Telegram when there has been no successful\napplication backup for 7 hours or no control-plane backup for 26 hours.\n`BackupMetricsMissing` fires if the metrics disappear altogether."},"288":{"id":"/docs/infrastructure/Guides/backups-21","page_id":"/docs/infrastructure/Guides/backups","tags":[],"type":"text","url":"/docs/infrastructure/Guides/backups#monitoring","content":"From the node:"},"289":{"id":"/docs/infrastructure/Guides/backups-22","page_id":"/docs/infrastructure/Guides/backups","tags":[],"type":"text","url":"/docs/infrastructure/Guides/backups#adding-a-new-app","content":"Volumes are not backed up automatically. If you add an app with data worth keeping\n(see Add Storage), add it to\n`ansible/roles/backup/templates/k3s-application-backup.sh.j2` in polinetwork-cd, using\nthe right tool for the data:"},"290":{"id":"/docs/infrastructure/Guides/backups-23","page_id":"/docs/infrastructure/Guides/backups","tags":[],"type":"text","url":"/docs/infrastructure/Guides/backups#adding-a-new-app","content":"a database: its own dump/backup command, through `kubectl exec` (like PostgreSQL and InfluxDB);"},"291":{"id":"/docs/infrastructure/Guides/backups-24","page_id":"/docs/infrastructure/Guides/backups","tags":[],"type":"text","url":"/docs/infrastructure/Guides/backups#adding-a-new-app","content":"an SQLite file: the `sqlite_backup` helper, which takes a consistent copy and archives\nthe other files in the volume;"},"292":{"id":"/docs/infrastructure/Guides/backups-25","page_id":"/docs/infrastructure/Guides/backups","tags":[],"type":"text","url":"/docs/infrastructure/Guides/backups#adding-a-new-app","content":"Redis: the `redis_snapshot` helper."},"293":{"id":"/docs/infrastructure/Guides/backups-26","page_id":"/docs/infrastructure/Guides/backups","tags":[],"type":"text","url":"/docs/infrastructure/Guides/backups#adding-a-new-app","content":"Then run the playbook (see K3s Node):\n`verify.yml` takes a fresh backup and checks it."},"294":{"id":"/docs/infrastructure/Guides/backups-27","page_id":"/docs/infrastructure/Guides/backups","tags":[],"type":"text","url":"/docs/infrastructure/Guides/backups#restoring","content":"Restoring overwrites live data. Agree on it with the Direttivo first, and take a\nfresh backup right before (`sudo systemctl start k3s-application-backup.service`)\nso you can go back."},"295":{"id":"/docs/infrastructure/Guides/backups-28","page_id":"/docs/infrastructure/Guides/backups","tags":[],"type":"text","url":"/docs/infrastructure/Guides/backups#1-get-the-archive","content":"The last 7 days are on the node, in `/srv/standard/backups/k3s-applications/`,\nreadable only by root. Copy the one you need to your home:"},"296":{"id":"/docs/infrastructure/Guides/backups-29","page_id":"/docs/infrastructure/Guides/backups","tags":[],"type":"text","url":"/docs/infrastructure/Guides/backups#1-get-the-archive","content":"For older backups, list and download them from Blob Storage on the node, with the\nbackup identity (its client ID is `backup_identity_client_id` in `ansible/vars/main.yml`):"},"297":{"id":"/docs/infrastructure/Guides/backups-30","page_id":"/docs/infrastructure/Guides/backups","tags":[],"type":"text","url":"/docs/infrastructure/Guides/backups#2-decrypt-it-on-your-machine","content":"Copy the encrypted archive to your machine and decrypt it there with\nage and the identity from Key Vault:"},"298":{"id":"/docs/infrastructure/Guides/backups-31","page_id":"/docs/infrastructure/Guides/backups","tags":[],"type":"text","url":"/docs/infrastructure/Guides/backups#2-decrypt-it-on-your-machine","content":"`restore/` now contains `postgres-dumpall.sql`, `redis.rdb`, `bot-ts-redis.rdb`,\n`influxdb-backup.tar`, `uptime-kuma.db`, `grafana.db` and the `*-files.tar` archives."},"299":{"id":"/docs/infrastructure/Guides/backups-32","page_id":"/docs/infrastructure/Guides/backups","tags":[],"type":"text","url":"/docs/infrastructure/Guides/backups#2-decrypt-it-on-your-machine","content":"These files hold personal data and credentials in clear text. Delete them as soon as\nyou're done."},"300":{"id":"/docs/infrastructure/Guides/backups-33","page_id":"/docs/infrastructure/Guides/backups","tags":[],"type":"text","url":"/docs/infrastructure/Guides/backups#3-restore-the-data","content":"For PostgreSQL, the dump recreates every database (`--clean --if-exists`), so you can\nstream it into the running server:"},"301":{"id":"/docs/infrastructure/Guides/backups-34","page_id":"/docs/infrastructure/Guides/backups","tags":[],"type":"text","url":"/docs/infrastructure/Guides/backups#3-restore-the-data","content":"For the other services, stop the app (`kubectl scale --replicas=0`), put the files back\nin its volume under `/srv/<fast|standard>/volumes/<namespace>/<pvc>/`, and scale it up\nagain. Follow the upstream docs for\nRedis and\nInfluxDB."},"302":{"id":"/docs/infrastructure/Guides/backups-35","page_id":"/docs/infrastructure/Guides/backups","tags":[],"type":"text","url":"/docs/infrastructure/Guides/backups#3-restore-the-data","content":"The control-plane backup is only needed to rebuild the node from scratch: it restores\nthe K3s datastore, including the service-account signing key that Azure workload\nidentity trusts."},"303":{"id":"/docs/infrastructure/Guides/deploy-a-new-app","page_id":"/docs/infrastructure/Guides/deploy-a-new-app","type":"page","content":"Deploy a New App","breadcrumbs":["Docs","Infrastructure","Guides"],"tags":[],"url":"/docs/infrastructure/Guides/deploy-a-new-app"},"304":{"id":"/docs/infrastructure/Guides/deploy-a-new-app-0","page_id":"/docs/infrastructure/Guides/deploy-a-new-app","type":"heading","tags":[],"url":"/docs/infrastructure/Guides/deploy-a-new-app#introduction","content":"Introduction"},"305":{"id":"/docs/infrastructure/Guides/deploy-a-new-app-1","page_id":"/docs/infrastructure/Guides/deploy-a-new-app","type":"heading","tags":[],"url":"/docs/infrastructure/Guides/deploy-a-new-app#procedure","content":"Procedure"},"306":{"id":"/docs/infrastructure/Guides/deploy-a-new-app-2","page_id":"/docs/infrastructure/Guides/deploy-a-new-app","type":"heading","tags":[],"url":"/docs/infrastructure/Guides/deploy-a-new-app#create-the-app-folder","content":"Create the app folder"},"307":{"id":"/docs/infrastructure/Guides/deploy-a-new-app-3","page_id":"/docs/infrastructure/Guides/deploy-a-new-app","type":"heading","tags":[],"url":"/docs/infrastructure/Guides/deploy-a-new-app#register-the-app-with-flux","content":"Register the app with Flux"},"308":{"id":"/docs/infrastructure/Guides/deploy-a-new-app-4","page_id":"/docs/infrastructure/Guides/deploy-a-new-app","type":"heading","tags":[],"url":"/docs/infrastructure/Guides/deploy-a-new-app#publish-it-on-a-domain","content":"Publish it on a domain"},"309":{"id":"/docs/infrastructure/Guides/deploy-a-new-app-5","page_id":"/docs/infrastructure/Guides/deploy-a-new-app","type":"heading","tags":[],"url":"/docs/infrastructure/Guides/deploy-a-new-app#automatic-image-updates","content":"Automatic image updates"},"310":{"id":"/docs/infrastructure/Guides/deploy-a-new-app-6","page_id":"/docs/infrastructure/Guides/deploy-a-new-app","type":"heading","tags":[],"url":"/docs/infrastructure/Guides/deploy-a-new-app#options","content":"Options"},"311":{"id":"/docs/infrastructure/Guides/deploy-a-new-app-7","page_id":"/docs/infrastructure/Guides/deploy-a-new-app","type":"heading","tags":[],"url":"/docs/infrastructure/Guides/deploy-a-new-app#disable-an-app","content":"Disable an app"},"312":{"id":"/docs/infrastructure/Guides/deploy-a-new-app-8","page_id":"/docs/infrastructure/Guides/deploy-a-new-app","type":"heading","tags":[],"url":"/docs/infrastructure/Guides/deploy-a-new-app#remove-an-app","content":"Remove an app"},"313":{"id":"/docs/infrastructure/Guides/deploy-a-new-app-9","page_id":"/docs/infrastructure/Guides/deploy-a-new-app","tags":[],"type":"text","url":"/docs/infrastructure/Guides/deploy-a-new-app#introduction","content":"We use k8s to deploy our applications, on our K3s node.  \nEach app is a folder of plain k8s manifests in the\npolinetwork-cd repository, tied\ntogether with Kustomize. Helm Charts\nare possible too, through a Flux `HelmRelease` (see `infrastructure/external-secrets` for an example)."},"314":{"id":"/docs/infrastructure/Guides/deploy-a-new-app-10","page_id":"/docs/infrastructure/Guides/deploy-a-new-app","tags":[],"type":"text","url":"/docs/infrastructure/Guides/deploy-a-new-app#introduction","content":"You don't deploy from your machine: you open a PR, and once it's merged into `main`,\nFlux applies it.  \nCheck minikube or K3s to run a k8s cluster on your machine for testing purposes."},"315":{"id":"/docs/infrastructure/Guides/deploy-a-new-app-11","page_id":"/docs/infrastructure/Guides/deploy-a-new-app","tags":[],"type":"text","url":"/docs/infrastructure/Guides/deploy-a-new-app#introduction","content":"To deploy our applications, we use Flux syncing the\n`clusters/k3s` folder of the `main` branch of\npolinetwork-cd."},"316":{"id":"/docs/infrastructure/Guides/deploy-a-new-app-12","page_id":"/docs/infrastructure/Guides/deploy-a-new-app","tags":[],"type":"text","url":"/docs/infrastructure/Guides/deploy-a-new-app#introduction","content":"For more info, check out Flux."},"317":{"id":"/docs/infrastructure/Guides/deploy-a-new-app-13","page_id":"/docs/infrastructure/Guides/deploy-a-new-app","tags":[],"type":"text","url":"/docs/infrastructure/Guides/deploy-a-new-app#procedure","content":"Publish a Docker image with an **`arm64`** variant"},"318":{"id":"/docs/infrastructure/Guides/deploy-a-new-app-14","page_id":"/docs/infrastructure/Guides/deploy-a-new-app","tags":[],"type":"text","url":"/docs/infrastructure/Guides/deploy-a-new-app#procedure","content":"Create the app folder"},"319":{"id":"/docs/infrastructure/Guides/deploy-a-new-app-15","page_id":"/docs/infrastructure/Guides/deploy-a-new-app","tags":[],"type":"text","url":"/docs/infrastructure/Guides/deploy-a-new-app#procedure","content":"Register the app with Flux"},"320":{"id":"/docs/infrastructure/Guides/deploy-a-new-app-16","page_id":"/docs/infrastructure/Guides/deploy-a-new-app","tags":[],"type":"text","url":"/docs/infrastructure/Guides/deploy-a-new-app#procedure","content":"Optionally, publish it on a domain, add secrets, add storage and enable automatic image updates"},"321":{"id":"/docs/infrastructure/Guides/deploy-a-new-app-17","page_id":"/docs/infrastructure/Guides/deploy-a-new-app","tags":[],"type":"text","url":"/docs/infrastructure/Guides/deploy-a-new-app#procedure","content":"Open a PR into polinetwork-cd, wait for CI, merge"},"322":{"id":"/docs/infrastructure/Guides/deploy-a-new-app-18","page_id":"/docs/infrastructure/Guides/deploy-a-new-app","tags":[],"type":"text","url":"/docs/infrastructure/Guides/deploy-a-new-app#procedure","content":"Monitor the deploy on the Flux Web UI"},"323":{"id":"/docs/infrastructure/Guides/deploy-a-new-app-19","page_id":"/docs/infrastructure/Guides/deploy-a-new-app","tags":[],"type":"text","url":"/docs/infrastructure/Guides/deploy-a-new-app#procedure","content":"The node is ARM64. An image built only for `amd64` can't run there, and the pod fails\nwith `exec format error`. Build a multi-arch image (see the\nweb workflow\nfor an example), or check that the third-party image you use publishes `linux/arm64`."},"324":{"id":"/docs/infrastructure/Guides/deploy-a-new-app-20","page_id":"/docs/infrastructure/Guides/deploy-a-new-app","tags":[],"type":"text","url":"/docs/infrastructure/Guides/deploy-a-new-app#create-the-app-folder","content":"This is the crucial part, so make sure to follow it step-by-step."},"325":{"id":"/docs/infrastructure/Guides/deploy-a-new-app-21","page_id":"/docs/infrastructure/Guides/deploy-a-new-app","tags":[],"type":"text","url":"/docs/infrastructure/Guides/deploy-a-new-app#create-the-app-folder","content":"Clone polinetwork-cd repo"},"326":{"id":"/docs/infrastructure/Guides/deploy-a-new-app-22","page_id":"/docs/infrastructure/Guides/deploy-a-new-app","tags":[],"type":"text","url":"/docs/infrastructure/Guides/deploy-a-new-app#create-the-app-folder","content":"Create a new branch (named as you like, e.g. `mc-server-deploy`)"},"327":{"id":"/docs/infrastructure/Guides/deploy-a-new-app-23","page_id":"/docs/infrastructure/Guides/deploy-a-new-app","tags":[],"type":"text","url":"/docs/infrastructure/Guides/deploy-a-new-app#create-the-app-folder","content":"Create this minimal file structure:"},"328":{"id":"/docs/infrastructure/Guides/deploy-a-new-app-24","page_id":"/docs/infrastructure/Guides/deploy-a-new-app","tags":[],"type":"text","url":"/docs/infrastructure/Guides/deploy-a-new-app#create-the-app-folder","content":"The `<k8s-namespace>` should be a slug (lowercase words separated by hyphens) identifier of the application/service you want to deploy."},"329":{"id":"/docs/infrastructure/Guides/deploy-a-new-app-25","page_id":"/docs/infrastructure/Guides/deploy-a-new-app","tags":[],"type":"text","url":"/docs/infrastructure/Guides/deploy-a-new-app#create-the-app-folder","content":"Use the same `<k8s-namespace>` value for the folder name, the `Namespace` resource and\nthe `namespace` field of `kustomization.yaml`. You don't need to write the namespace in\nthe other manifests: Kustomize adds it."},"330":{"id":"/docs/infrastructure/Guides/deploy-a-new-app-26","page_id":"/docs/infrastructure/Guides/deploy-a-new-app","tags":[],"type":"text","url":"/docs/infrastructure/Guides/deploy-a-new-app#create-the-app-folder","content":"The `prune: disabled` annotation keeps Flux from deleting the namespace, and with it\neverything inside, if the app is removed from Git by mistake."},"331":{"id":"/docs/infrastructure/Guides/deploy-a-new-app-27","page_id":"/docs/infrastructure/Guides/deploy-a-new-app","tags":[],"type":"text","url":"/docs/infrastructure/Guides/deploy-a-new-app#create-the-app-folder","content":"A few rules we follow for every app:"},"332":{"id":"/docs/infrastructure/Guides/deploy-a-new-app-28","page_id":"/docs/infrastructure/Guides/deploy-a-new-app","tags":[],"type":"text","url":"/docs/infrastructure/Guides/deploy-a-new-app#create-the-app-folder","content":"**Requests and limits.** Everything shares one node, so every container declares\nits memory request and limit. Base the numbers on what the app actually uses\n(`kubectl top pods`)."},"333":{"id":"/docs/infrastructure/Guides/deploy-a-new-app-29","page_id":"/docs/infrastructure/Guides/deploy-a-new-app","tags":[],"type":"text","url":"/docs/infrastructure/Guides/deploy-a-new-app#create-the-app-folder","content":"**Probes.** The readiness probe is what makes rolling updates safe: without it,\nKubernetes kills the old pod before the new one is serving."},"334":{"id":"/docs/infrastructure/Guides/deploy-a-new-app-30","page_id":"/docs/infrastructure/Guides/deploy-a-new-app","tags":[],"type":"text","url":"/docs/infrastructure/Guides/deploy-a-new-app#create-the-app-folder","content":"**Apps with a volume** use `strategy: Recreate` instead (see Add Storage)."},"335":{"id":"/docs/infrastructure/Guides/deploy-a-new-app-31","page_id":"/docs/infrastructure/Guides/deploy-a-new-app","tags":[],"type":"text","url":"/docs/infrastructure/Guides/deploy-a-new-app#create-the-app-folder","content":"Apps talk to each other through their Service:\n`http://<service>.<namespace>.svc.cluster.local:<port>`."},"336":{"id":"/docs/infrastructure/Guides/deploy-a-new-app-32","page_id":"/docs/infrastructure/Guides/deploy-a-new-app","tags":[],"type":"text","url":"/docs/infrastructure/Guides/deploy-a-new-app#register-the-app-with-flux","content":"Flux only deploys the apps listed in `clusters/k3s/apps/`. Create a Flux\n`Kustomization` for the app:"},"337":{"id":"/docs/infrastructure/Guides/deploy-a-new-app-33","page_id":"/docs/infrastructure/Guides/deploy-a-new-app","tags":[],"type":"text","url":"/docs/infrastructure/Guides/deploy-a-new-app#register-the-app-with-flux","content":"If the app needs another app to be up first (e.g. a database), add it to\n`dependsOn` (e.g. `- name: postgres`)."},"338":{"id":"/docs/infrastructure/Guides/deploy-a-new-app-34","page_id":"/docs/infrastructure/Guides/deploy-a-new-app","tags":[],"type":"text","url":"/docs/infrastructure/Guides/deploy-a-new-app#register-the-app-with-flux","content":"Then add it to the list:"},"339":{"id":"/docs/infrastructure/Guides/deploy-a-new-app-35","page_id":"/docs/infrastructure/Guides/deploy-a-new-app","tags":[],"type":"text","url":"/docs/infrastructure/Guides/deploy-a-new-app#register-the-app-with-flux","content":"If you want automatic image updates, write a `ResourceSet` instead of this\n`Kustomization`: see below."},"340":{"id":"/docs/infrastructure/Guides/deploy-a-new-app-36","page_id":"/docs/infrastructure/Guides/deploy-a-new-app","tags":[],"type":"text","url":"/docs/infrastructure/Guides/deploy-a-new-app#publish-it-on-a-domain","content":"Public traffic arrives through the Cloudflare Tunnel to Traefik, which routes it by\nhostname. Two things are needed."},"341":{"id":"/docs/infrastructure/Guides/deploy-a-new-app-37","page_id":"/docs/infrastructure/Guides/deploy-a-new-app","tags":[],"type":"text","url":"/docs/infrastructure/Guides/deploy-a-new-app#publish-it-on-a-domain","content":"An `Ingress` in the app folder (and in `kustomization.yaml`):"},"342":{"id":"/docs/infrastructure/Guides/deploy-a-new-app-38","page_id":"/docs/infrastructure/Guides/deploy-a-new-app","tags":[],"type":"text","url":"/docs/infrastructure/Guides/deploy-a-new-app#publish-it-on-a-domain","content":"A public hostname on the **`k3s01`** tunnel in the Cloudflare Zero Trust dashboard\n(*Networks → Tunnels*), pointing to Traefik like the existing hostnames. The tunnel\nis managed from the dashboard, not from Git, so ask someone in the Direttivo to add it."},"343":{"id":"/docs/infrastructure/Guides/deploy-a-new-app-39","page_id":"/docs/infrastructure/Guides/deploy-a-new-app","tags":[],"type":"text","url":"/docs/infrastructure/Guides/deploy-a-new-app#publish-it-on-a-domain","content":"Cloudflare terminates HTTPS, so the `Ingress` only needs the plain `web` entrypoint:\nno certificates in the cluster."},"344":{"id":"/docs/infrastructure/Guides/deploy-a-new-app-40","page_id":"/docs/infrastructure/Guides/deploy-a-new-app","tags":[],"type":"text","url":"/docs/infrastructure/Guides/deploy-a-new-app#automatic-image-updates","content":"Flux can redeploy the app every time a new `latest` image is published, pinning the\nimage digest (see how it works).  \nThis is an optional feature: the alternative is a fixed version or digest in\n`deployment.yaml` (e.g. `nginx:1.27.4`), bumped with a PR."},"345":{"id":"/docs/infrastructure/Guides/deploy-a-new-app-41","page_id":"/docs/infrastructure/Guides/deploy-a-new-app","tags":[],"type":"text","url":"/docs/infrastructure/Guides/deploy-a-new-app#automatic-image-updates","content":"Consider the following manifest:"},"346":{"id":"/docs/infrastructure/Guides/deploy-a-new-app-42","page_id":"/docs/infrastructure/Guides/deploy-a-new-app","tags":[],"type":"text","url":"/docs/infrastructure/Guides/deploy-a-new-app#automatic-image-updates","content":"the image would **not update** if you **don't follow** this guide, even though there is `latest`:\nthe node already has an image called `nginx:latest` and has no reason to pull it again."},"347":{"id":"/docs/infrastructure/Guides/deploy-a-new-app-43","page_id":"/docs/infrastructure/Guides/deploy-a-new-app","tags":[],"type":"text","url":"/docs/infrastructure/Guides/deploy-a-new-app#automatic-image-updates","content":"The image must be **public** on GHCR: neither Flux nor the node use registry credentials.\nUsing the GHCR package `ghcr.io/polinetworkorg/<image>`:"},"348":{"id":"/docs/infrastructure/Guides/deploy-a-new-app-44","page_id":"/docs/infrastructure/Guides/deploy-a-new-app","tags":[],"type":"text","url":"/docs/infrastructure/Guides/deploy-a-new-app#automatic-image-updates","content":"Add a provider that tracks its `latest` tag:"},"349":{"id":"/docs/infrastructure/Guides/deploy-a-new-app-45","page_id":"/docs/infrastructure/Guides/deploy-a-new-app","tags":[],"type":"text","url":"/docs/infrastructure/Guides/deploy-a-new-app#automatic-image-updates","content":"Let the GitHub webhook trigger it:"},"350":{"id":"/docs/infrastructure/Guides/deploy-a-new-app-46","page_id":"/docs/infrastructure/Guides/deploy-a-new-app","tags":[],"type":"text","url":"/docs/infrastructure/Guides/deploy-a-new-app#automatic-image-updates","content":"Replace `clusters/k3s/apps/<k8s-namespace>.yaml` with a `ResourceSet` that renders the\nsame Kustomization, plus an `images` override with the digest:"},"351":{"id":"/docs/infrastructure/Guides/deploy-a-new-app-47","page_id":"/docs/infrastructure/Guides/deploy-a-new-app","tags":[],"type":"text","url":"/docs/infrastructure/Guides/deploy-a-new-app#automatic-image-updates","content":"The inputs are named after the provider, with hyphens turned into underscores:\nthe provider `bot-ts-image` becomes `inputs.bot_ts_image`."},"352":{"id":"/docs/infrastructure/Guides/deploy-a-new-app-48","page_id":"/docs/infrastructure/Guides/deploy-a-new-app","tags":[],"type":"text","url":"/docs/infrastructure/Guides/deploy-a-new-app#automatic-image-updates","content":"In `deployment.yaml`, keep `image: ghcr.io/polinetworkorg/<image>:latest`: the `name`\nunder `images` must match it exactly, and Flux replaces it with the pinned digest.\nSee `clusters/k3s/apps/web.yaml` for a complete example."},"353":{"id":"/docs/infrastructure/Guides/deploy-a-new-app-49","page_id":"/docs/infrastructure/Guides/deploy-a-new-app","tags":[],"type":"text","url":"/docs/infrastructure/Guides/deploy-a-new-app#options","content":"These are some useful operations on existing apps."},"354":{"id":"/docs/infrastructure/Guides/deploy-a-new-app-50","page_id":"/docs/infrastructure/Guides/deploy-a-new-app","tags":[],"type":"text","url":"/docs/infrastructure/Guides/deploy-a-new-app#disable-an-app","content":"To stop an app temporarily, **suspend** its Kustomization in the\nFlux Web UI and scale it down from the node:"},"355":{"id":"/docs/infrastructure/Guides/deploy-a-new-app-51","page_id":"/docs/infrastructure/Guides/deploy-a-new-app","tags":[],"type":"text","url":"/docs/infrastructure/Guides/deploy-a-new-app#disable-an-app","content":"To bring it back, **resume** the Kustomization: Flux restores the replicas from Git."},"356":{"id":"/docs/infrastructure/Guides/deploy-a-new-app-52","page_id":"/docs/infrastructure/Guides/deploy-a-new-app","tags":[],"type":"text","url":"/docs/infrastructure/Guides/deploy-a-new-app#remove-an-app","content":"Remove `<k8s-namespace>.yaml` from `clusters/k3s/apps/kustomization.yaml` and delete the\nfile and the `apps/<k8s-namespace>/` folder. Remove its provider and receiver entry too,\nif it had automatic image updates."},"357":{"id":"/docs/infrastructure/Guides/deploy-a-new-app-53","page_id":"/docs/infrastructure/Guides/deploy-a-new-app","tags":[],"type":"text","url":"/docs/infrastructure/Guides/deploy-a-new-app#remove-an-app","content":"Once merged, Flux deletes the app's resources, except the ones annotated with\n`prune: disabled`: the namespace, the PVCs and, for apps with automatic image\nupdates, the generated Kustomization. Delete those by hand from the node once you're\nsure the data is not needed:"},"358":{"id":"/docs/infrastructure/Guides/deploy-a-new-app-54","page_id":"/docs/infrastructure/Guides/deploy-a-new-app","tags":[],"type":"text","url":"/docs/infrastructure/Guides/deploy-a-new-app#remove-an-app","content":"Volume directories stay on disk anyway (`reclaimPolicy: Retain`), under\n`/srv/<fast|standard>/volumes/<k8s-namespace>/`."},"359":{"id":"/docs/infrastructure/Guides/deploy-a-new-app-55","page_id":"/docs/infrastructure/Guides/deploy-a-new-app","tags":[],"type":"text","url":"/docs/infrastructure/Guides/deploy-a-new-app#remove-an-app","content":"The `config.json` files with `\"disabled\": true` you may find at the root of polinetwork-cd\nbelong to the old ArgoCD setup. Flux doesn't read them."},"360":{"id":"/docs/infrastructure/Introduction","page_id":"/docs/infrastructure/Introduction","type":"page","content":"Intro","breadcrumbs":["Docs","Infrastructure"],"tags":[],"url":"/docs/infrastructure/Introduction"},"361":{"id":"/docs/infrastructure/Introduction-0","page_id":"/docs/infrastructure/Introduction","type":"heading","tags":[],"url":"/docs/infrastructure/Introduction#getting-started","content":"Getting Started"},"362":{"id":"/docs/infrastructure/Introduction-1","page_id":"/docs/infrastructure/Introduction","type":"heading","tags":[],"url":"/docs/infrastructure/Introduction#where","content":"Where"},"363":{"id":"/docs/infrastructure/Introduction-2","page_id":"/docs/infrastructure/Introduction","type":"heading","tags":[],"url":"/docs/infrastructure/Introduction#what","content":"What"},"364":{"id":"/docs/infrastructure/Introduction-3","page_id":"/docs/infrastructure/Introduction","type":"heading","tags":[],"url":"/docs/infrastructure/Introduction#why","content":"Why"},"365":{"id":"/docs/infrastructure/Introduction-4","page_id":"/docs/infrastructure/Introduction","type":"heading","tags":[],"url":"/docs/infrastructure/Introduction#about-this-documentation","content":"About this documentation"},"366":{"id":"/docs/infrastructure/Introduction-5","page_id":"/docs/infrastructure/Introduction","tags":[],"type":"text","url":"/docs/infrastructure/Introduction","content":"Let's discover **PoliNetwork's Infrastructure in less than 5 minutes**."},"367":{"id":"/docs/infrastructure/Introduction-6","page_id":"/docs/infrastructure/Introduction","tags":[],"type":"text","url":"/docs/infrastructure/Introduction#where","content":"Our infrastructure is deployed on Azure West Europe (Amsterdam).\nThe Azure resources are described in Terraform (IaC) in the\nterraform repository."},"368":{"id":"/docs/infrastructure/Introduction-7","page_id":"/docs/infrastructure/Introduction","tags":[],"type":"text","url":"/docs/infrastructure/Introduction#what","content":"Production runs on **K3s**, a lightweight Kubernetes distribution, installed on\na single Azure ARM64 VM called `k3s01`. Around it there are a few Azure services\n(Key Vault, Managed Disks, Blob Storage, Entra ID) and Cloudflare, which\npublishes our websites through a tunnel and gives us SSH access to the VM."},"369":{"id":"/docs/infrastructure/Introduction-8","page_id":"/docs/infrastructure/Introduction","tags":[],"type":"text","url":"/docs/infrastructure/Introduction#what","content":"Three layers, three tools:"},"370":{"id":"/docs/infrastructure/Introduction-9","page_id":"/docs/infrastructure/Introduction","tags":[],"type":"text","url":"/docs/infrastructure/Introduction#what","content":"| Layer                                                        | Tool      | Repository |\n| ------------------------------------------------------------ | --------- | ---------- |\n| Azure resources (VM, disks, network, Key Vaults, identities) | Terraform | terraform  |","table":"table-0"},"371":{"id":"/docs/infrastructure/Introduction-10","page_id":"/docs/infrastructure/Introduction","tags":[],"type":"text","url":"/docs/infrastructure/Introduction#what","content":"| Layer                                         | Tool    | Repository             |\n| --------------------------------------------- | ------- | ---------------------- |\n| The VM itself (disks, firewall, K3s, backups) | Ansible | polinetwork-cd/ansible |","table":"table-0"},"372":{"id":"/docs/infrastructure/Introduction-11","page_id":"/docs/infrastructure/Introduction","tags":[],"type":"text","url":"/docs/infrastructure/Introduction#what","content":"| Layer                                | Tool          | Repository     |\n| ------------------------------------ | ------------- | -------------- |\n| Everything running inside Kubernetes | Flux (GitOps) | polinetwork-cd |","table":"table-0"},"373":{"id":"/docs/infrastructure/Introduction-12","page_id":"/docs/infrastructure/Introduction","tags":[],"type":"text","url":"/docs/infrastructure/Introduction#why","content":"Why Kubernetes on a single VM instead of plain Docker?\nKubernetes gives us declarative deployments, rolling updates, health checks and\nper-application resource limits. Flux keeps the cluster in sync with Git, so the\n`polinetwork-cd` repository is always the source of truth for what is running."},"374":{"id":"/docs/infrastructure/Introduction-13","page_id":"/docs/infrastructure/Introduction","tags":[],"type":"text","url":"/docs/infrastructure/Introduction#why","content":"Why K3s instead of a managed cluster?\nUntil October 2026 we ran on AKS (Azure Kubernetes Service). K3s gives us the\nsame Kubernetes API on one VM that we fully control and size ourselves, and it\ndrops our dependency on AKS-specific add-ons (Azure CSI drivers, Longhorn, ArgoCD)."},"375":{"id":"/docs/infrastructure/Introduction-14","page_id":"/docs/infrastructure/Introduction","tags":[],"type":"text","url":"/docs/infrastructure/Introduction#why","content":"The AKS cluster `aks-polinetwork` is still defined in the `environments/legacy`\nTerraform root, but no production workload runs on it anymore.\nIf you find instructions mentioning `az aks get-credentials`, ArgoCD,\n`SecretProviderClass` or Longhorn (e.g. in old READMEs), they refer to the AKS setup."},"376":{"id":"/docs/infrastructure/Introduction-15","page_id":"/docs/infrastructure/Introduction","tags":[],"type":"text","url":"/docs/infrastructure/Introduction#about-this-documentation","content":"Most of the docs explain procedures with `kubectl`, which you run on the K3s node\nover SSH, and with the Azure CLI, which you use for Key Vault secrets.\nMake sure to set up your access to follow along."},"377":{"id":"/docs/infrastructure/Introduction-16","page_id":"/docs/infrastructure/Introduction","tags":[],"type":"text","url":"/docs/infrastructure/Introduction#about-this-documentation","content":"The best place to start is going through the Getting Started section to get a high level overview of how things are organized.  \nIf you're looking for a guide on how to achieve a specific outcome, you can look in the Guides."},"378":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/flux","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/flux","type":"page","content":"Flux","breadcrumbs":["Docs","Infrastructure","Getting Started","Cloud Infrastructure"],"tags":[],"url":"/docs/infrastructure/getting-started/cloud-infrastructure/flux"},"379":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/flux-0","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/flux","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/flux","content":"How Flux deploys the polinetwork-cd repository to the K3s cluster."},"380":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/flux-1","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/flux","type":"heading","tags":[],"url":"/docs/infrastructure/getting-started/cloud-infrastructure/flux#what-is-flux","content":"What is Flux?"},"381":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/flux-2","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/flux","type":"heading","tags":[],"url":"/docs/infrastructure/getting-started/cloud-infrastructure/flux#repository-layout","content":"Repository layout"},"382":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/flux-3","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/flux","type":"heading","tags":[],"url":"/docs/infrastructure/getting-started/cloud-infrastructure/flux#clustersk3s","content":"`clusters/k3s`"},"383":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/flux-4","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/flux","type":"heading","tags":[],"url":"/docs/infrastructure/getting-started/cloud-infrastructure/flux#platform-components-infrastructure","content":"Platform components (`infrastructure/`)"},"384":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/flux-5","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/flux","type":"heading","tags":[],"url":"/docs/infrastructure/getting-started/cloud-infrastructure/flux#automatic-image-updates","content":"Automatic image updates"},"385":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/flux-6","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/flux","type":"heading","tags":[],"url":"/docs/infrastructure/getting-started/cloud-infrastructure/flux#day-to-day","content":"Day-to-day"},"386":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/flux-7","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/flux","type":"heading","tags":[],"url":"/docs/infrastructure/getting-started/cloud-infrastructure/flux#web-ui","content":"Web UI"},"387":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/flux-8","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/flux","type":"heading","tags":[],"url":"/docs/infrastructure/getting-started/cloud-infrastructure/flux#from-the-node","content":"From the node"},"388":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/flux-9","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/flux","type":"heading","tags":[],"url":"/docs/infrastructure/getting-started/cloud-infrastructure/flux#references","content":"References"},"389":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/flux-10","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/flux","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/flux#what-is-flux","content":"Flux is a GitOps tool: it runs inside the cluster, watches a\nGit repository and applies whatever it finds there, over and over. If someone\nchanges a resource by hand, Flux puts it back the way Git says. It replaced the\nArgoCD instance we had on AKS."},"390":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/flux-11","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/flux","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/flux#what-is-flux","content":"Ours is installed by Ansible through the\nFlux Operator, and it syncs the\n**`main`** branch of\npolinetwork-cd, starting\nfrom the `clusters/k3s` folder."},"391":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/flux-12","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/flux","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/flux#what-is-flux","content":"Merging to `main` in polinetwork-cd **is** deploying to production.\nNever `kubectl apply` or `kubectl edit` a resource that Flux manages: Flux reverts\nit at the next reconciliation."},"392":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/flux-13","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/flux","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/flux#repository-layout","content":"Folders at the root of the repository (`bot-prod/`, `bot-rooms/`, `mariadb/`, ...)\nare leftovers from the AKS era, all disabled. Flux ignores them."},"393":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/flux-14","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/flux","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/flux#clustersk3s","content":"Each file here is a Flux\n`Kustomization`\nthat points to one folder of `infrastructure/` or `apps/`. It also sets:"},"394":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/flux-15","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/flux","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/flux#clustersk3s","content":"`dependsOn`: what must be ready first. Apps wait for the secret stores, storage\nand Traefik; `backend` also waits for `postgres` and `redis`."},"395":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/flux-16","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/flux","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/flux#clustersk3s","content":"`prune: true`: a resource removed from Git is deleted from the cluster."},"396":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/flux-17","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/flux","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/flux#clustersk3s","content":"`wait: true`: the Kustomization is ready only when all its resources are healthy."},"397":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/flux-18","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/flux","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/flux#clustersk3s","content":"`interval: 30m`: a full reconciliation at least every 30 minutes, even if Git\ndidn't change."},"398":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/flux-19","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/flux","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/flux#clustersk3s","content":"`clusters/k3s/apps/kustomization.yaml` lists the apps Flux runs. An app file\nthat is not listed there does nothing."},"399":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/flux-20","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/flux","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/flux#platform-components-infrastructure","content":"| Component  | What it does                                                          |\n| ---------- | --------------------------------------------------------------------- |\n| `security` | Admission policies (no host namespaces, no pods as `keyvault-reader`) |","table":"table-0"},"400":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/flux-21","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/flux","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/flux#platform-components-infrastructure","content":"| Component | What it does                                                       |\n| --------- | ------------------------------------------------------------------ |\n| `storage` | local-path provisioner and the `fast` / `standard` storage classes |","table":"table-0"},"401":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/flux-22","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/flux","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/flux#platform-components-infrastructure","content":"| Component | What it does                                    |\n| --------- | ----------------------------------------------- |\n| `traefik` | Makes the bundled Traefik a `ClusterIP` service |","table":"table-0"},"402":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/flux-23","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/flux","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/flux#platform-components-infrastructure","content":"| Component          | What it does                                   |\n| ------------------ | ---------------------------------------------- |\n| `external-secrets` | External Secrets Operator, installed with Helm |","table":"table-0"},"403":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/flux-24","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/flux","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/flux#platform-components-infrastructure","content":"| Component       | What it does                                             |\n| --------------- | -------------------------------------------------------- |\n| `secret-stores` | The `kv-pn-apps` and `kv-pn-infra` `ClusterSecretStore`s |","table":"table-0"},"404":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/flux-25","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/flux","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/flux#platform-components-infrastructure","content":"| Component     | What it does                                 |\n| ------------- | -------------------------------------------- |\n| `cloudflared` | The Cloudflare Tunnel connector (2 replicas) |","table":"table-0"},"405":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/flux-26","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/flux","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/flux#platform-components-infrastructure","content":"| Component          | What it does                                    |\n| ------------------ | ----------------------------------------------- |\n| `image-automation` | Detects new `latest` images on GHCR (see below) |","table":"table-0"},"406":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/flux-27","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/flux","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/flux#platform-components-infrastructure","content":"| Component       | What it does                |\n| --------------- | --------------------------- |\n| `node-exporter` | Node metrics for Prometheus |","table":"table-0"},"407":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/flux-28","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/flux","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/flux#platform-components-infrastructure","content":"| Component  | What it does                            |\n| ---------- | --------------------------------------- |\n| `flux-web` | The Flux Web UI at flux.polinetwork.org |","table":"table-0"},"408":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/flux-29","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/flux","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/flux#automatic-image-updates","content":"Most of our apps are deployed from the `latest` tag of an image on\nGHCR. A tag can point to a\ndifferent image over time, so Flux resolves it to a **digest** and deploys that\ndigest. When the digest changes, the app rolls out the new image."},"409":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/flux-30","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/flux","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/flux#automatic-image-updates","content":"The pieces, all in polinetwork-cd:"},"410":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/flux-31","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/flux","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/flux#automatic-image-updates","content":"`infrastructure/image-automation/image-providers.yaml`: one\n`ResourceSetInputProvider` per image, which reads the `latest` tag and its digest."},"411":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/flux-32","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/flux","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/flux#automatic-image-updates","content":"`infrastructure/image-automation/receiver.yaml`: a Flux `Receiver` called by\nthe PoliNetworkOrg organization webhook on `package` events, at\n`flux-webhook.polinetwork.org`. The webhook's HMAC signature is its only\nauthentication. If the webhook doesn't fire, the providers poll every 6 hours anyway."},"412":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/flux-33","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/flux","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/flux#automatic-image-updates","content":"`clusters/k3s/apps/<app>.yaml`: for apps with automatic updates this is a\n`ResourceSet` instead of a plain Kustomization. It generates the app's\nKustomization with an `images` override that pins the digest."},"413":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/flux-34","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/flux","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/flux#automatic-image-updates","content":"Apps that don't need automatic updates (databases, monitoring, ...) pin their\nimage in the manifest, and you bump them with a PR."},"414":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/flux-35","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/flux","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/flux#web-ui","content":"flux.polinetwork.org shows every Kustomization,\nHelmRelease and ResourceSet, with its status, last applied revision and errors.\nYou log in through auth.polinetwork.org; only\nthe Direttivo is admitted. From the UI you can **reconcile** (sync now),\n**suspend** and **resume** any resource."},"415":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/flux-36","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/flux","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/flux#from-the-node","content":"The `flux` CLI isn't installed on the node, but the Flux resources are regular\nKubernetes objects:"},"416":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/flux-37","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/flux","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/flux#from-the-node","content":"To stop Flux from touching an app while you debug it by hand, **suspend** its\nKustomization from the Web UI. Remember to **resume** it afterwards: a suspended\napp also stops receiving image updates."},"417":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/flux-38","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/flux","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/flux#references","content":"Flux Documentation"},"418":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/flux-39","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/flux","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/flux#references","content":"Flux Operator Documentation"},"419":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/flux-40","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/flux","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/flux#references","content":"ResourceSets"},"420":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/flux-41","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/flux","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/flux#references","content":"PoliNetwork-CD Repository"},"421":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure","type":"page","content":"Cloud Infrastructure","breadcrumbs":["Docs","Infrastructure","Getting Started","Cloud Infrastructure"],"tags":[],"url":"/docs/infrastructure/getting-started/cloud-infrastructure"},"422":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure-0","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure","type":"heading","tags":[],"url":"/docs/infrastructure/getting-started/cloud-infrastructure#overview","content":"Overview"},"423":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure-1","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure","type":"heading","tags":[],"url":"/docs/infrastructure/getting-started/cloud-infrastructure#terraform-definition-and-purpose","content":"**Terraform: Definition and Purpose**"},"424":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure-2","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure","type":"heading","tags":[],"url":"/docs/infrastructure/getting-started/cloud-infrastructure#polinetwork-cd-definition-and-purpose","content":"**PoliNetwork-CD: Definition and Purpose**"},"425":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure-3","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure","type":"heading","tags":[],"url":"/docs/infrastructure/getting-started/cloud-infrastructure#key-difference-infrastructure-vs-deployment","content":"**Key Difference: Infrastructure vs. Deployment**"},"426":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure-4","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure","type":"heading","tags":[],"url":"/docs/infrastructure/getting-started/cloud-infrastructure#how-a-request-reaches-an-app","content":"How a request reaches an app"},"427":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure-5","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure","type":"heading","tags":[],"url":"/docs/infrastructure/getting-started/cloud-infrastructure#references","content":"References"},"428":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure-6","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure","type":"heading","tags":[],"url":"/docs/infrastructure/getting-started/cloud-infrastructure#links-to-repositories","content":"**Links to Repositories**"},"429":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure-7","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure","type":"heading","tags":[],"url":"/docs/infrastructure/getting-started/cloud-infrastructure#additional-resources","content":"**Additional Resources**"},"430":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure-8","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure#overview","content":"This section explains how we organized our infrastructure."},"431":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure-9","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure#overview","content":"Everything regarding the deployment of apps and services is divided into two repositories:"},"432":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure-10","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure#overview","content":"polinetworkorg/terraform - Contains the Terraform code for the Azure resources: the `k3s01` VM, its disks and network, the Key Vaults, the managed identities, the backup storage account."},"433":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure-11","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure#overview","content":"polinetworkorg/polinetwork-cd - Our GitOps repo. It contains the Ansible playbooks that turn the VM into a K3s node, and the Kubernetes manifests of every app and service. Flux, running in the cluster, applies them."},"434":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure-12","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure#terraform-definition-and-purpose","content":"The **Terraform** repository is responsible for managing and provisioning cloud infrastructure. In simple terms, it defines and creates the resources needed for the infrastructure, such as:"},"435":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure-13","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure#terraform-definition-and-purpose","content":"**Networks and subnets** (Virtual Network, NAT Gateway for outbound traffic, Network Security Group)"},"436":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure-14","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure#terraform-definition-and-purpose","content":"**Virtual machines** (the `k3s01` K3s node)"},"437":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure-15","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure#terraform-definition-and-purpose","content":"**Storage** (Managed Disks for the node, Blob Storage for backups and Terraform state)"},"438":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure-16","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure#terraform-definition-and-purpose","content":"**Security services** (Key Vaults, managed identities, workload identity federation)"},"439":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure-17","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure#terraform-definition-and-purpose","content":"The code in **Terraform** describes these resources declaratively: it defines the desired state, and Terraform applies the necessary changes to reach that state. This repository is primarily used to **create and modify the cloud infrastructure** where applications will run."},"440":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure-18","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure#terraform-definition-and-purpose","content":"Terraform stops at the Azure boundary: it creates the VM, but it doesn't configure\nwhat runs inside it."},"441":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure-19","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure#polinetwork-cd-definition-and-purpose","content":"The **PoliNetwork-CD** (Continuous Deployment) repository picks up where Terraform stops. It has two parts:"},"442":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure-20","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure#polinetwork-cd-definition-and-purpose","content":"**`ansible/`** configures the VM: it mounts the data disks, hardens SSH and the\nfirewall, installs a pinned K3s version, schedules the encrypted backups and\nbootstraps Flux. You run it by hand, rarely."},"443":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure-21","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure#polinetwork-cd-definition-and-purpose","content":"**`clusters/k3s/`, `infrastructure/` and `apps/`** describe everything inside\nKubernetes. **Flux** watches the `main` branch and applies it continuously, so you\nnever run `kubectl apply` by hand."},"444":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure-22","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure#polinetwork-cd-definition-and-purpose","content":"Through Flux, the repository is used to:"},"445":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure-23","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure#polinetwork-cd-definition-and-purpose","content":"**Define application deployments** in Kubernetes (plain manifests organized with Kustomize, or Helm charts)"},"446":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure-24","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure#polinetwork-cd-definition-and-purpose","content":"**Automatically update applications** when a new `latest` image is published"},"447":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure-25","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure#polinetwork-cd-definition-and-purpose","content":"**Manage application configurations** (environment variables, secrets pulled from Key Vault)"},"448":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure-26","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure#polinetwork-cd-definition-and-purpose","content":"**Monitor the state of applications** and ensure they remain in sync with the repository"},"449":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure-27","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure#polinetwork-cd-definition-and-purpose","content":"While Terraform is responsible for infrastructure, **PoliNetwork-CD** focuses on **managing the lifecycle of applications** running on that infrastructure, ensuring that code changes are applied automatically and securely."},"450":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure-28","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure#key-difference-infrastructure-vs-deployment","content":"| Repository    | Main Purpose                             | Example of Managed Resources               |\n| ------------- | ---------------------------------------- | ------------------------------------------ |\n| **Terraform** | Creates and manages cloud infrastructure | VM, disks, network, Key Vaults, identities |","table":"table-0"},"451":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure-29","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure#key-difference-infrastructure-vs-deployment","content":"| Repository                      | Main Purpose      | Example of Managed Resources             |\n| ------------------------------- | ----------------- | ---------------------------------------- |\n| **PoliNetwork-CD** (`ansible/`) | Configures the VM | Disk mounts, firewall, SSH, K3s, backups |","table":"table-0"},"452":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure-30","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure#key-difference-infrastructure-vs-deployment","content":"| Repository                | Main Purpose                                 | Example of Managed Resources             |\n| ------------------------- | -------------------------------------------- | ---------------------------------------- |\n| **PoliNetwork-CD** (Flux) | Automates application deployment and updates | Deployments, ingresses, secrets, storage |","table":"table-0"},"453":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure-31","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure#key-difference-infrastructure-vs-deployment","content":"In summary, **Terraform builds the foundation on which applications run**, while **PoliNetwork-CD sets up the node and manages the deployment and continuous updating of applications**. Both repositories work together to ensure a scalable and efficient cloud infrastructure."},"454":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure-32","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure#how-a-request-reaches-an-app","content":"A visitor opens e.g. `https://api.polinetwork.org`. DNS points to Cloudflare."},"455":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure-33","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure#how-a-request-reaches-an-app","content":"Cloudflare sends the request through the `k3s01` tunnel to one of the two\n`cloudflared` pods in the cluster."},"456":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure-34","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure#how-a-request-reaches-an-app","content":"`cloudflared` forwards it to **Traefik**, the K3s ingress controller."},"457":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure-35","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure#how-a-request-reaches-an-app","content":"Traefik picks the app from the `Ingress` whose `host` matches, and forwards the\nrequest to that app's `Service`."},"458":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure-36","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure#how-a-request-reaches-an-app","content":"The VM never accepts inbound connections from the Internet: the tunnel is an\noutbound connection, and outbound traffic leaves Azure through a NAT Gateway."},"459":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure-37","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure#how-a-request-reaches-an-app","content":"<Card title=\"Terraform\" href=\"/docs/infrastructure/getting-started/cloud-infrastructure/terraform\" description=\"Detailed overview of our Azure-based infrastructure managed via the polinetworkorg/terraform reposit…\" />"},"460":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure-38","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure#how-a-request-reaches-an-app","content":"<Card title=\"K3s Node\" href=\"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node\" description=\"The k3s01 VM, how Ansible configures it, and how to run the playbooks.\" />"},"461":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure-39","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure#how-a-request-reaches-an-app","content":"<Card title=\"Flux\" href=\"/docs/infrastructure/getting-started/cloud-infrastructure/flux\" description=\"How Flux deploys the polinetwork-cd repository to the K3s cluster.\" />"},"462":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure-40","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure#links-to-repositories","content":"Terraform Repository"},"463":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure-41","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure#links-to-repositories","content":"PoliNetwork-CD Repository"},"464":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure-42","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure#additional-resources","content":"Kubernetes Documentation"},"465":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure-43","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure#additional-resources","content":"K3s Documentation"},"466":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure-44","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure#additional-resources","content":"Flux Documentation"},"467":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure-45","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure#additional-resources","content":"Terraform Documentation"},"468":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node","type":"page","content":"K3s Node","breadcrumbs":["Docs","Infrastructure","Getting Started","Cloud Infrastructure"],"tags":[],"url":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node"},"469":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node-0","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node","content":"The k3s01 VM, how Ansible configures it, and how to run the playbooks."},"470":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node-1","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node","type":"heading","tags":[],"url":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node#overview","content":"Overview"},"471":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node-2","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node","type":"heading","tags":[],"url":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node#disks","content":"Disks"},"472":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node-3","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node","type":"heading","tags":[],"url":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node#what-ansible-sets-up","content":"What Ansible sets up"},"473":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node-4","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node","type":"heading","tags":[],"url":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node#notable-k3s-settings","content":"Notable K3s settings"},"474":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node-5","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node","type":"heading","tags":[],"url":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node#security-guardrails","content":"Security guardrails"},"475":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node-6","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node","type":"heading","tags":[],"url":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node#running-the-playbooks","content":"Running the playbooks"},"476":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node-7","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node","type":"heading","tags":[],"url":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node#ci","content":"CI"},"477":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node-8","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node","type":"heading","tags":[],"url":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node#upgrading-k3s","content":"Upgrading K3s"},"478":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node-9","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node#overview","content":"Production runs on a single VM, **`k3s01`**, created by Terraform\n(`environments/k3s`) and configured by the Ansible playbooks in\n`polinetwork-cd/ansible`."},"479":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node-10","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node#overview","content":"|      |                                                 |\n| ---- | ----------------------------------------------- |\n| Size | `Standard_E2ps_v6` (ARM64), West Europe, zone 1 |","table":"table-0"},"480":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node-11","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node#overview","content":"|     |                 |\n| --- | --------------- |\n| OS  | Debian 13 ARM64 |","table":"table-0"},"481":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node-12","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node#overview","content":"|            |                            |\n| ---------- | -------------------------- |\n| Private IP | `10.43.1.4` (no public IP) |","table":"table-0"},"482":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node-13","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node#overview","content":"|            |                                                                       |\n| ---------- | --------------------------------------------------------------------- |\n| Kubernetes | K3s, single server node, pinned version (see `ansible/vars/main.yml`) |","table":"table-0"},"483":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node-14","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node#overview","content":"|            |           |\n| ---------- | --------- |\n| Admin user | `pnadmin` |","table":"table-0"},"484":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node-15","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node#overview","content":"The node is ARM64. Every image we deploy must have a `linux/arm64` variant,\notherwise the pod fails with `exec format error`. Our GitHub workflows publish\nmulti-arch images (`amd64` + `arm64`) for this reason."},"485":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node-16","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node#disks","content":"| Mount | Azure disk      | Type                | Used for         |\n| ----- | --------------- | ------------------- | ---------------- |\n| `/`   | `disk-k3s01-os` | Standard SSD, 64 GB | Operating system |","table":"table-1"},"486":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node-17","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node#disks","content":"| Mount       | Azure disk              | Type                  | Used for                                        |\n| ----------- | ----------------------- | --------------------- | ----------------------------------------------- |\n| `/srv/fast` | `disk-k3s-fast` (LUN 0) | Premium SSD v2, 64 GB | Volumes of the `fast` storage class (databases) |","table":"table-1"},"487":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node-18","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node#disks","content":"| Mount           | Azure disk                  | Type                 | Used for                                                                                      |\n| --------------- | --------------------------- | -------------------- | --------------------------------------------------------------------------------------------- |\n| `/srv/standard` | `disk-k3s-standard` (LUN 1) | Standard SSD, 128 GB | K3s data (`/srv/standard/k3s`), volumes of the `standard` storage class, local backup staging |","table":"table-1"},"488":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node-19","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node#disks","content":"Ansible finds the data disks by Azure LUN, refuses to touch a disk that is\nsmaller than expected or holds an unexpected filesystem, formats them only when\nblank and mounts them by UUID. Both disks have `prevent_destroy` in Terraform."},"489":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node-20","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node#disks","content":"See Add Storage for how volumes are carved out of these disks."},"490":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node-21","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node#what-ansible-sets-up","content":"The provisioning playbook (`ansible/playbooks/provision.yml`) applies these roles, in order:"},"491":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node-22","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node#what-ansible-sets-up","content":"| Role   | What it does                                                                                                     |\n| ------ | ---------------------------------------------------------------------------------------------------------------- |\n| `base` | Base packages, UTC timezone, `pnadmin` user and the `k3s-admin` group, kernel modules and sysctls for Kubernetes |","table":"table-2"},"492":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node-23","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node#what-ansible-sets-up","content":"| Role       | What it does                                                                                                                                                    |\n| ---------- | --------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `security` | SSH hardening (keys and Cloudflare Access certificates only), Debian security updates via `unattended-upgrades` (no automatic reboot), `nftables` host firewall |","table":"table-2"},"493":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node-24","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node#what-ansible-sets-up","content":"| Role      | What it does                                                |\n| --------- | ----------------------------------------------------------- |\n| `storage` | Formats and mounts the data disks, creates `/srv/*/volumes` |","table":"table-2"},"494":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node-25","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node#what-ansible-sets-up","content":"| Role  | What it does                                                                                                |\n| ----- | ----------------------------------------------------------------------------------------------------------- |\n| `k3s` | Installs the pinned K3s binary (checked by SHA-256) and its configuration, waits for the node to be `Ready` |","table":"table-2"},"495":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node-26","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node#what-ansible-sets-up","content":"| Role     | What it does                                                                 |\n| -------- | ---------------------------------------------------------------------------- |\n| `backup` | Installs the encrypted backup scripts and their systemd timers (see Backups) |","table":"table-2"},"496":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node-27","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node#what-ansible-sets-up","content":"| Role   | What it does                                                                                              |\n| ------ | --------------------------------------------------------------------------------------------------------- |\n| `flux` | Installs the pinned Flux Operator and the `FluxInstance` that syncs `clusters/k3s` from the `main` branch |","table":"table-2"},"497":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node-28","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node#what-ansible-sets-up","content":"After that, Flux takes over everything inside the cluster (see Flux)."},"498":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node-29","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node#notable-k3s-settings","content":"**Pod and Service CIDRs** are `10.52.0.0/16` and `10.53.0.0/16`. The K3s\ndefault `10.43.0.0/16` would collide with the Azure VNet."},"499":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node-30","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node#notable-k3s-settings","content":"**ServiceLB** and the bundled **local-storage** are disabled. Storage comes from\nthe local-path provisioner managed by Flux."},"500":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node-31","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node#notable-k3s-settings","content":"The bundled **Traefik** stays as the ingress controller, but Flux turns its\nService into `ClusterIP`: only `cloudflared` reaches it."},"501":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node-32","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node#notable-k3s-settings","content":"**Secrets encryption** at rest is enabled."},"502":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node-33","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node#notable-k3s-settings","content":"The API server signs service-account tokens for a public OIDC issuer\n(`pnk3soidc` storage account). Azure trusts that issuer, which is how External\nSecrets reads Key Vault without any stored credential."},"503":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node-34","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node#security-guardrails","content":"The VM has no public IP and the NSG denies all inbound traffic. The host\nfirewall drops everything except SSH, the node itself and cluster traffic."},"504":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node-35","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node#security-guardrails","content":"Pods cannot reach the Azure Instance Metadata Service (`169.254.169.254`), so\nthey can't borrow the VM's managed identities."},"505":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node-36","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node#security-guardrails","content":"An admission policy rejects pods using `hostNetwork`, `hostPID` or `hostIPC`\noutside `kube-system`, and another one forbids pods from running as the\n`keyvault-reader` service account."},"506":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node-37","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node#running-the-playbooks","content":"You rarely need this: day-to-day changes go through Flux. Run Ansible when you\nchange something under `ansible/` (e.g. a K3s upgrade or a new backup target).\nOnly the IT Lead group has access to the node."},"507":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node-38","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node#running-the-playbooks","content":"The playbooks run from your machine against `10.43.1.4` over SSH, so connect\nWARP first."},"508":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node-39","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node#running-the-playbooks","content":"The script is the only supported way to apply changes. It runs the playbook in\ncheck mode, then applies it twice and fails if the second run still changes\nsomething (the playbook must be idempotent). Finally it runs\n`playbooks/verify.yml`, which checks the disks, the K3s version, the firewall,\nthe SSH configuration, that Flux is ready, that pods can't reach Azure IMDS, and\nit takes and validates a fresh backup. Logs are saved in `ansible/artifacts/`\n(ignored by Git)."},"509":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node-40","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node#running-the-playbooks","content":"To run from inside the VM (for example through Azure Run Command), put a reviewed\ncheckout on the VM and run:"},"510":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node-41","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node#running-the-playbooks","content":"Never copy a private SSH key or a secret value into the repository or into Azure\nRun Command parameters."},"511":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node-42","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node#ci","content":"The **Ansible** workflow in polinetwork-cd runs on every pull request that\ntouches `ansible/`, `clusters/k3s/`, `infrastructure/`, `apps/` or `tests/`. It\nruns `ansible-lint`, `shellcheck`, a playbook syntax check, `kustomize build` on\nevery Flux path and the manifest tests in `tests/`. It does **not** touch the VM."},"512":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node-43","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node#upgrading-k3s","content":"Pick a release from K3s releases and\ndownload its `k3s-arm64` binary checksum."},"513":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node-44","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node#upgrading-k3s","content":"Update `k3s_version`, `k3s_release_url` and `k3s_sha256` in `ansible/vars/main.yml`."},"514":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node-45","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node#upgrading-k3s","content":"Open a PR, merge it, then run `./scripts/provision-and-verify.sh`. K3s restarts\nwith the new binary; workloads come back on their own."},"515":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node-46","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node#upgrading-k3s","content":"The Flux Operator is upgraded the same way (`flux_operator_*` and\n`flux_distribution_version`)."},"516":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node-47","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/k3s-node#upgrading-k3s","content":"The workload identity trust relies on the cluster's service-account signing key,\nwhose public part is committed in Terraform\n(`environments/k3s/k3s-service-account-jwks.json`). If the node is rebuilt from\nscratch without restoring the control-plane backup, the key changes and that file\nmust be updated, otherwise External Secrets can't read Key Vault."},"517":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform","type":"page","content":"Terraform","breadcrumbs":["Docs","Infrastructure","Getting Started","Cloud Infrastructure"],"tags":[],"url":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform"},"518":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform-0","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform","content":"Detailed overview of our Azure-based infrastructure managed via the polinetworkorg/terraform repository."},"519":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform-1","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform","type":"heading","tags":[],"url":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform#what-is-terraform","content":"What is Terraform?"},"520":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform-2","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform","type":"heading","tags":[],"url":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform#why-we-use-terraform","content":"Why We Use Terraform"},"521":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform-3","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform","type":"heading","tags":[],"url":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform#how-terraform-works","content":"How Terraform Works"},"522":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform-4","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform","type":"heading","tags":[],"url":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform#terraform-code-vs-terraform-state-vs-azure-state","content":"Terraform Code vs. Terraform State vs. Azure State"},"523":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform-5","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform","type":"heading","tags":[],"url":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform#terraform-implementation-overview","content":"Terraform Implementation Overview"},"524":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform-6","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform","type":"heading","tags":[],"url":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform#repository-overview","content":"Repository Overview"},"525":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform-7","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform","type":"heading","tags":[],"url":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform#infrastructure-structure","content":"Infrastructure Structure"},"526":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform-8","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform","type":"heading","tags":[],"url":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform#state-management","content":"State Management"},"527":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform-9","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform","type":"heading","tags":[],"url":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform#access-and-authorization","content":"Access and Authorization"},"528":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform-10","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform","type":"heading","tags":[],"url":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform#funding-and-nonprofit-considerations","content":"Funding and Nonprofit Considerations"},"529":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform-11","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform","type":"heading","tags":[],"url":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform#making-changes-to-the-infrastructure","content":"Making Changes to the Infrastructure"},"530":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform-12","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform","type":"heading","tags":[],"url":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform#basic-workflow-for-infrastructure-changes","content":"Basic Workflow for Infrastructure Changes"},"531":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform-13","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform","type":"heading","tags":[],"url":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform#basic-terraform-cli-commands","content":"Basic Terraform CLI Commands"},"532":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform-14","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform","type":"heading","tags":[],"url":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform#references","content":"References"},"533":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform-15","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform#what-is-terraform","content":"Terraform is an open-source Infrastructure as Code (IaC) tool developed by\nHashiCorp. It allows you to define, provision, and manage the infrastructure\nusing a declarative configuration language. This means you describe the desired\nstate of the infrastructure, and Terraform takes care of creating and updating\nthe resources to match that state."},"534":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform-16","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform#what-is-terraform","content":"This documentation assumes you already have the Terraform CLI installed on your\nlocal machine. If you need help setting up Terraform, please refer to the\nofficial documentation."},"535":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform-17","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform#what-is-terraform","content":"You'll also need to be logged in with the Azure CLI and have the necessary\npermissions to manage the resources in our Azure subscription (more on this\nhere)."},"536":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform-18","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform#what-is-terraform","content":"Once you have logged in to the Azure CLI, select the subscription and export it\nfor the provider:"},"537":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform-19","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform#what-is-terraform","content":"More about this in the repository README."},"538":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform-20","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform#why-we-use-terraform","content":"Our organization leverages Terraform to manage our Azure cloud infrastructure for several important reasons:"},"539":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform-21","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform#why-we-use-terraform","content":"**Consistency:** Defining our infrastructure as code ensures that every environment is configured the same way, reducing the chance of human error."},"540":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform-22","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform#why-we-use-terraform","content":"**Automation:** Terraform automates the provisioning and modification of resources, streamlining our deployment processes."},"541":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform-23","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform#why-we-use-terraform","content":"**Version Control:** Storing Terraform configurations in version control systems allows us to track changes, collaborate effectively, and revert to previous versions if needed."},"542":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform-24","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform#why-we-use-terraform","content":"**Modularity:** Terraform encourages breaking down the infrastructure into reusable modules, which simplifies management and enhances maintainability."},"543":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform-25","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform#how-terraform-works","content":"To run terraform commands you need to have the right permissions and credentials.\nIf you are not sure about your permissions, please contact the IT department (but\nif you have to ask you probably shouldn't run `apply` yourself anyway)."},"544":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform-26","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform#how-terraform-works","content":"If you haven't yet set up the Azure CLI please refer to the setup guide."},"545":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform-27","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform#how-terraform-works","content":"Terraform operates through a simple yet powerful workflow:"},"546":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform-28","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform#how-terraform-works","content":"**Write:** You define the infrastructure in configuration files (typically with a `.tf` extension)."},"547":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform-29","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform#how-terraform-works","content":"**Plan:** Running `terraform plan` generates an execution plan, showing you the changes Terraform will make to achieve the desired state."},"548":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform-30","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform#how-terraform-works","content":"**Apply:** Executing `terraform apply` implements the changes, creating or updating the infrastructure accordingly."},"549":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform-31","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform#how-terraform-works","content":"Running Terraform commands can modify the cloud infrastructure."},"550":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform-32","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform#how-terraform-works","content":"**THIS CAN INCUR COSTS OR CAUSE DOWNTIME AND PERMANENT DATA LOSS IF NOT DONE PROPERLY.**"},"551":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform-33","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform#how-terraform-works","content":"Always review the execution plan (`terraform plan`) before applying changes."},"552":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform-34","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform#terraform-code-vs-terraform-state-vs-azure-state","content":"**Terraform Code:**  \nThis consists of the configuration files that describe your desired\ninfrastructure. These files are the blueprint for what you want the infrastructure to look like."},"553":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform-35","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform#terraform-code-vs-terraform-state-vs-azure-state","content":"**Terraform State:**  \nThe state file (we have two of them, see State Management) records the current state\nof the infrastructure as managed by Terraform. This file is critical because\nit maps your configuration to the real-world resources, tracks dependencies,\nand allows Terraform to detect what needs to change during updates. Our state\nfile is stored remotely (in an Azure Storage Account) and is locked using\nAzure's integrated leasing mechanism to prevent concurrent modifications."},"554":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform-36","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform#terraform-code-vs-terraform-state-vs-azure-state","content":"**Azure State:**  \nThis is the actual state of resources deployed in the Azure environment.\nWhile Terraform keeps track of these resources via its state file, the real\nconfiguration and runtime details exist within Azure. The Terraform state acts\nas an intermediary, ensuring that the desired state (from the Terraform code)\nand the actual state (in Azure) are in sync. If resources are modified directly\nin Azure without updating Terraform, discrepancies may occur, highlighting the\nimportance of using Terraform as the single source of truth."},"555":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform-37","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform#terraform-code-vs-terraform-state-vs-azure-state","content":"This clear separation between code, Terraform state, and the actual cloud state\nis key to maintaining a reliable and predictable infrastructure."},"556":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform-38","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform#terraform-implementation-overview","content":"Welcome to the documentation for the **polinetworkorg/terraform** repository.\nThis page provides an in-depth look at our Terraform implementation on\n**Microsoft Azure**, detailing the architecture of our infrastructure and the\nkey modules that make it up. While this overview highlights our main components,\nit’s important to note that there are alternative approaches to similar problems,\nand our setup is tailored to our current needs."},"557":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform-39","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform#repository-overview","content":"The **polinetworkorg/terraform** repository is our centralized solution for\nprovisioning and managing cloud infrastructure on Azure. Its default branch is\n**`stable`**."},"558":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform-40","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform#repository-overview","content":"The code is split into two independent **root modules** (the folders you run\n`terraform` in). Each root owns its resources and has its own state file; a root\ncan only read the other's resources through data sources, never declare them."},"559":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform-41","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform#repository-overview","content":"**`environments/k3s`:** the production K3s platform. It defines:"},"560":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform-42","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform#repository-overview","content":"the `k3s01` VM (Debian 13 ARM64) and its two data disks, `disk-k3s-fast`\n(Premium SSD v2, 64 GB) and `disk-k3s-standard` (Standard SSD, 128 GB);"},"561":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform-43","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform#repository-overview","content":"the network: `vnet-k3s` (`10.43.0.0/16`), a NAT Gateway for outbound traffic,\nand an NSG that denies all inbound traffic;"},"562":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform-44","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform#repository-overview","content":"the Key Vaults `kv-pn-apps` (application secrets) and `kv-pn-infra`\n(platform secrets);"},"563":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform-45","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform#repository-overview","content":"the managed identities, including the one External Secrets uses through\nworkload identity federation, and the public OIDC issuer the cluster's\nservice-account tokens are verified against."},"564":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform-46","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform#repository-overview","content":"**`environments/legacy`:** everything from before the migration: the old AKS\ncluster and its Kubernetes/Helm resources (ArgoCD, Longhorn, Kubernetes\nDashboard, MariaDB, ...), plus shared resources such as the resource group\n`rg-polinetwork`, the backup storage account `polinetworkbackups` and the budgets."},"565":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform-47","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform#repository-overview","content":"What runs *inside* the VM is not managed here: see K3s Node and Flux."},"566":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform-48","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform#repository-overview","content":"While the choices made in this implementation reflect our specific requirements\nand constraints, it's worth noting that other approaches exist for managing\ncloud infrastructure with Terraform."},"567":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform-49","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform#repository-overview","content":"Our modular design, state management strategy,\nand access controls are tailored to our current operational needs and funding\nsituation—but they are not set in stone. Please feel free to reach out to the\nIT department if you have any questions or suggestions."},"568":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform-50","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform#infrastructure-structure","content":"Our repository is organized to clearly separate concerns and promote reusability.\nWhile the exact folder structure may vary, a typical layout looks like this:"},"569":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform-51","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform#state-management","content":"We use an **Azure Storage Account** for managing the Terraform state. The state\nfiles are stored within a dedicated container named `terraform-state`,\nas defined in our **storage** module:"},"570":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform-52","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform#state-management","content":"| Root                  | State file      |\n| --------------------- | --------------- |\n| `environments/legacy` | `state.tfstate` |","table":"table-0"},"571":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform-53","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform#state-management","content":"| Root               | State file    |\n| ------------------ | ------------- |\n| `environments/k3s` | `k3s.tfstate` |","table":"table-0"},"572":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform-54","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform#state-management","content":"The integrated leasing mechanism provided\nby the Azure Storage Account is used for state locking, ensuring that concurrent\nTerraform operations do not conflict with each other."},"573":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform-55","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform#access-and-authorization","content":"Given the critical nature of our infrastructure, modifications (e.g., running\n`terraform apply`) are restricted to personnel with sufficient clearance. As an\nassociation, any infrastructure changes require approval from either the Head of\nthe IT Department or the Directive Council. All authorization is managed through\n**Microsoft's Entra ID system**, ensuring that only properly authenticated and\nauthorized users can perform these operations."},"574":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform-56","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform#funding-and-nonprofit-considerations","content":"As a nonprofit organization, we benefit from a **Microsoft Azure Grant for Nonprofits**,\nwhich provides us with a budget of **€2000 per year**. This support helps offset\nour cloud costs and underpins our commitment to maintaining a robust and scalable\ninfrastructure."},"575":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform-57","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform#funding-and-nonprofit-considerations","content":"This is one of the core reasons we are structured as a nonprofit organization, and why\nwe use Azure as our cloud provider."},"576":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform-58","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform#funding-and-nonprofit-considerations","content":"You can find more about our benefits here."},"577":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform-59","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform#funding-and-nonprofit-considerations","content":"If you have access to the adminorg account, you can check the current status of\nour Azure grant here."},"578":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform-60","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform#making-changes-to-the-infrastructure","content":"This section provides a basic guide on how to update our infrastructure using\nTerraform and introduces some of the automated workflows that help us maintain\nconsistency and control."},"579":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform-61","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform#basic-workflow-for-infrastructure-changes","content":"**Edit the Terraform Code:**  \nModify the relevant configuration files to define your desired changes in the\ninfrastructure. Most changes belong to `environments/k3s`."},"580":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform-62","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform#basic-workflow-for-infrastructure-changes","content":"**Review Your Changes Locally:**  \nRun `terraform -chdir=environments/<root> plan` to generate an execution plan.\nThis command will show you what changes will be made to align the actual\ninfrastructure with your code."},"581":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform-63","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform#basic-workflow-for-infrastructure-changes","content":"**Open a Pull Request against `stable`:**  \nThe **Terraform workflow** runs format, init, validate and plan for both roots\nand posts one comment per root with the plan. Pull requests never apply."},"582":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform-64","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform#basic-workflow-for-infrastructure-changes","content":"**Cost Estimation with Infracost:**  \nWhen you open a pull request, our **Infracost workflow** is triggered\nautomatically. This workflow calculates the estimated cost impact of your\nchanges and posts a report in the pull request comments, so you can review\nany potential cost implications before merging."},"583":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform-65","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform#basic-workflow-for-infrastructure-changes","content":"If you want to run Infracost locally, you can install it by following the\nofficial documentation."},"584":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform-66","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform#basic-workflow-for-infrastructure-changes","content":"**Apply the Changes:**  \nAfter your changes have been reviewed and approved, merge the pull request.\nThe push to `stable` runs the plans again, then waits for a maintainer to\napprove the GitHub **`production`** environment. Once approved, it applies\n`k3s` first and `legacy` second. You don't run `terraform apply` yourself."},"585":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform-67","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform#basic-workflow-for-infrastructure-changes","content":"**Drift Detection:**  \nA nightly **Drift workflow** runs to detect any discrepancies between the\ncurrent Terraform state and the actual state in Azure. If this workflow\ndetects a drift from what the `terraform plan` output would predict, it\nautomatically opens an issue for further investigation.\nAt the moment it only checks the `legacy` root."},"586":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform-68","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform#basic-terraform-cli-commands","content":"Always pick a root with `-chdir`, e.g. `terraform -chdir=environments/k3s plan`.\nRunning Terraform at the repository root does nothing useful."},"587":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform-69","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform#basic-terraform-cli-commands","content":"**`terraform init`**  \nInitializes the working directory containing the Terraform configuration files."},"588":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform-70","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform#basic-terraform-cli-commands","content":"This has to be run as soon as you clone the repository or when you pull changes\nthat include new modules or providers. Locally, add\n`-backend-config=use_oidc=false` (OIDC is only for GitHub Actions)."},"589":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform-71","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform#basic-terraform-cli-commands","content":"**`terraform plan`**  \nGenerates an execution plan showing what changes will be applied to the infrastructure."},"590":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform-72","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform#basic-terraform-cli-commands","content":"**`terraform apply`**  \nApplies the changes defined in your Terraform configuration to the cloud environment.\nIn practice the Terraform workflow does this for you after the `production` approval."},"591":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform-73","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform#basic-terraform-cli-commands","content":"**`terraform destroy`**  \nDestroys the resources managed by Terraform, useful for tearing down test environments or decommissioning infrastructure."},"592":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform-74","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform#basic-terraform-cli-commands","content":"If you ever happen to be as much as tempted of using `terraform destroy`, you\nbetter be **SURE AS SHIT** about what you are doing. Never run it without\n`-chdir`, and remember the K3s data disks have `prevent_destroy` for a reason. Make sure to review the\nimplications thoroughly before proceeding."},"593":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform-75","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform#basic-terraform-cli-commands","content":"> *One does not simply destroy PoliNetwork with one command.*"},"594":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform-76","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform#basic-terraform-cli-commands","content":"By following these steps and leveraging our automated workflows, you ensure that\ninfrastructure changes are managed in a consistent, cost-aware, and controlled\nmanner."},"595":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform-77","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform#references","content":"Terraform Documentation"},"596":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform-78","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform#references","content":"Microsoft Azure Documentation"},"597":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform-79","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform#references","content":"Infracost Documentation"},"598":{"id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform-80","page_id":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform","tags":[],"type":"text","url":"/docs/infrastructure/getting-started/cloud-infrastructure/terraform#references","content":"Terraform Repository"},"599":{"id":"/docs/infrastructure/getting-started/k8s-basics/day-to-day/monitoring","page_id":"/docs/infrastructure/getting-started/k8s-basics/day-to-day/monitoring","type":"page","content":"Monitoring","breadcrumbs":["Docs","Infrastructure","Getting Started","K8s Basics","Day-to-day"],"tags":[],"url":"/docs/infrastructure/getting-started/k8s-basics/day-to-day/monitoring"},"600":{"id":"/docs/infrastructure/getting-started/k8s-basics/day-to-day/monitoring-0","page_id":"/docs/infrastructure/getting-started/k8s-basi